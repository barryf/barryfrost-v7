---
import BaseHead from '@/components/BaseHead.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import '../styles/global.css';
import type { PUBLICATIONS } from '@/lib/standard-site';

interface Props {
  title: string;
  description?: string;
  standardRkey?: string;
  standardPublication?: keyof typeof PUBLICATIONS;
  publishedDate?: Date;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const { title, description, standardRkey, standardPublication, publishedDate, ogImage, ogImageAlt, ogImageWidth, ogImageHeight } = Astro.props;
---
<html lang="en-GB">
  <head>
    <BaseHead title={title} description={description} standardRkey={standardRkey} standardPublication={standardPublication} publishedDate={publishedDate} ogImage={ogImage} ogImageAlt={ogImageAlt} ogImageWidth={ogImageWidth} ogImageHeight={ogImageHeight} />
  </head>
  <body class="m-4 sm:m-8 bg-white dark:bg-black text-gray-600 dark:text-gray-400 font-sans antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-white focus:dark:bg-black focus:px-3 focus:py-1 focus:underline">Skip to content</a>
    <header>
      <SiteHeader />
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <SiteFooter />
    </footer>
  </body>
</html>
