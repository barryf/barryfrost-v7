---
import BaseHead from '@/components/BaseHead.astro';
import Divider from '@/components/Divider.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  showHomeNav?: boolean;
}

const { title, description, showHomeNav = true } = Astro.props;
---
<html lang="en-GB">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="mx-6 bg-white dark:bg-black text-gray-800 dark:text-gray-200 font-sans antialiased">
    <div class="mt-4 mb-20 max-w-xl mx-auto">
      {showHomeNav && (
        <nav class="mb-12 h-4 text-center">
          <a href="/" class="underline" title="Home">&uarr;</a>
        </nav>
      )}
      <slot />
      <Divider />
      <SiteFooter />
    </div>
  </body>
</html>
