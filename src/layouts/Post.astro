---
import Base from './Base.astro';
import { formatDateTitle, formatDateRelative, isRelativeDate, toISODate } from '@/lib/dates';
import Divider from '@/components/Divider.astro'
import AuthorCard from '@/components/AuthorCard.astro';
import Syndication from '@/components/Syndication.astro';

import type { PUBLICATIONS } from '@/lib/standard-site';

interface Props {
  /** Rendered as-is in the h1 and every head tag — callers fold in any emoji prefix. */
  title: string;
  date: Date;
  description?: string;
  section?: string;
  sectionHref?: string;
  standardRkey?: string;
  standardPublication?: keyof typeof PUBLICATIONS;
  syndication?: string[];
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const { title, date, description, section, sectionHref, standardRkey, standardPublication, syndication, ogImage, ogImageAlt, ogImageWidth, ogImageHeight } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Drop "on" for relative phrasing ("Posted 3 days ago") but keep it for absolute
// dates ("Posted on 22 Apr 2026").
const dateConnector = isRelativeDate(date) ? '' : 'on ';
---
<Base title={title} description={description} standardRkey={standardRkey} standardPublication={standardPublication} publishedDate={date} ogImage={ogImage} ogImageAlt={ogImageAlt} ogImageWidth={ogImageWidth} ogImageHeight={ogImageHeight}>
  <article class="h-entry" data-pagefind-body>
    <h1 class="p-name mb-4 text-black dark:text-white font-semibold">{title}</h1>
    <a class="u-url hidden" href={canonical}>{canonical}</a>
    <AuthorCard />
    <div class="e-content prose dark:prose-invert max-w-none mb-4">
      <slot />
    </div>
    <Divider />
    <div class="mb-4 text-sm">
      {section && sectionHref ? (
        <Fragment>
          Posted in <a href={sectionHref} class="underline">{section}</a>{' '}{dateConnector}<time class="dt-published" datetime={toISODate(date)} title={formatDateTitle(date)}>{formatDateRelative(date)}</time>
        </Fragment>
      ) : (
        <Fragment>
          Posted {dateConnector}<time class="dt-published" datetime={toISODate(date)} title={formatDateTitle(date)}>{formatDateRelative(date)}</time>
        </Fragment>
      )}
      <Syndication urls={syndication} />
    </div>
<slot name="nav" />
  </article>
</Base>
