---
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import { formatDate, formatDateShort, formatRelativeDate, toISODate } from '@/lib/dates';

interface Props {
  title: string;
  date: Date;
  description?: string;
  emoji?: string;
  section?: string;
  sectionHref?: string;
}

const { title, date, description, emoji, section, sectionHref } = Astro.props;
const relativeDate = formatRelativeDate(date);
const datePreposition = relativeDate === formatDateShort(date) ? ' on ' : '';

// Find matching document in PDS for syndication link
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const documents = await getCollection('documents');
const matchingDoc = documents.find(doc => doc.data.path === currentPath);
---
<Base title={title} description={description}>
  <article class="h-entry" data-pagefind-body>
    <h1 class="p-name mb-4 text-black dark:text-white font-semibold">{emoji && `${emoji} `}{title}</h1>
    <a class="p-author h-card hidden" data-pagefind-ignore rel="author" href="https://barryfrost.com">
      <img class="u-photo" src="https://barryfrost.com/barryfrost.jpg" alt="Barry Frost" />
      <span class="p-name">Barry Frost</span>
      <span class="u-url">https://barryfrost.com</span>
    </a>
    <div class="e-content prose dark:prose-invert max-w-none mb-4">
      <slot />
    </div>
    <div class="mb-4">—</div>
    <div class="mb-4 text-sm">
      {section && sectionHref ? (
        <Fragment>
          Posted in <a href={sectionHref} class="underline">{section}</a>
          {datePreposition} <time class="dt-published" datetime={toISODate(date)} title={formatDate(date)}>{relativeDate}</time>
        </Fragment>
      ) : (
        <Fragment>
          Posted{datePreposition} <time class="dt-published" datetime={toISODate(date)} title={formatDate(date)}>{relativeDate}</time>
        </Fragment>
      )}
    </div>
    {matchingDoc && (
      <div class="mb-4 text-gray-500 dark:text-gray-500" data-pagefind-ignore>
        <a class="u-syndication underline" href={matchingDoc.data.uri} rel="syndication">View on AT Protocol</a>
      </div>
    )}
    <slot name="nav" />
  </article>
</Base>
