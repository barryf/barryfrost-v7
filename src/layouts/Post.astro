---
import Base from './Base.astro';
import { formatDateTitle, formatDateRelative, isRelativeDate, toISODate } from '@/lib/dates';
import { cleanPathname } from '@/lib/url';
import AuthorCard from '@/components/AuthorCard.astro';
import Syndication from '@/components/Syndication.astro';

import type { PUBLICATIONS } from '@/lib/standard-site';

interface Props {
  /** Rendered as-is in the h1 and every head tag — callers fold in any emoji prefix. */
  title: string;
  date: Date;
  description?: string;
  section?: string;
  sectionHref?: string;
  standardRkey?: string;
  standardPublication?: keyof typeof PUBLICATIONS;
  syndication?: string[];
  /** Float the "nav" slot into a right-hand column once there's room for it. */
  navAside?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const { title, date, description, section, sectionHref, standardRkey, standardPublication, syndication, navAside, ogImage, ogImageAlt, ogImageWidth, ogImageHeight } = Astro.props;
// Must match BaseHead's rel=canonical exactly: build.format 'file' makes Astro.url.pathname
// end in .html, and MF2 consumers (webmention.io, Bridgy, IndieNews) treat u-url as the
// post's identity — a .html variant here would disagree with the canonical we publish.
const canonical = new URL(cleanPathname(Astro.url.pathname), Astro.site).href;
// Below lg the columns collapse and everything stacks in source order, so the
// aside classes are additive — no separate stacked markup needed. items-start
// pins the aside to the top of the body whatever the body starts with;
// items-baseline would take the main column's baseline from a leading image's
// bottom edge and push the aside down the height of the image.
const columnsClass = navAside ? 'lg:flex lg:items-start lg:gap-20' : '';
// Body text is already capped at max-w-140, so cap the column to match rather
// than letting flex-1 stretch it and strand the aside at the far right.
const mainColumnClass = navAside ? 'min-w-0 lg:flex-1 lg:max-w-140' : '';
// The columns use different font sizes, so flush box tops would leave the
// smaller aside text sitting visibly high: pt-1 (0.25rem) is half the leading
// difference between the prose body and the text-sm aside, which lands their
// first baselines together as items-baseline used to for text-led posts.
const asideColumnClass = navAside ? 'lg:w-64 lg:shrink-0 lg:pt-1' : '';
// Drop "on" for relative phrasing ("Posted 3 days ago") but keep it for absolute
// dates ("Posted on 22 Apr 2026").
const dateConnector = isRelativeDate(date) ? '' : 'on ';
---
<Base title={title} description={description} standardRkey={standardRkey} standardPublication={standardPublication} publishedDate={date} ogImage={ogImage} ogImageAlt={ogImageAlt} ogImageWidth={ogImageWidth} ogImageHeight={ogImageHeight}>
  <article class="h-entry mt-8" data-pagefind-body>
    <h1 class="p-name mb-4 text-black dark:text-white font-semibold">{title}</h1>
    {/* Empty text, as in SiteHeader's h-card: u-url reads the href, and any text here
        would sit inside data-pagefind-body and pollute every search excerpt. */}
    <a class="u-url hidden" href={canonical}></a>
    <AuthorCard />
    <div class={columnsClass}>
      <div class={mainColumnClass}>
        <div class="e-content post prose dark:prose-invert max-w-none mb-8">
          <slot />
        </div>
        <div class="text-sm text-gray-500 dark:text-gray-400">
          Posted{section && sectionHref && <Fragment> in <a href={sectionHref} class="underline">{section}</a></Fragment>} {dateConnector}<time class="dt-published" datetime={toISODate(date)} title={formatDateTitle(date)}>{formatDateRelative(date)}</time><Syndication urls={syndication} standardRkey={standardRkey} />.
        </div>
      </div>
      <div class={asideColumnClass}>
        <slot name="nav" />
      </div>
    </div>
  </article>
</Base>
