---
import Base from './Base.astro';
import { formatDateTitle, formatDateShort, toISODate } from '@/lib/dates';
import Divider from '@/components/Divider.astro'
import AuthorCard from '@/components/AuthorCard.astro';

import type { PUBLICATIONS } from '@/lib/standard-site';

interface Props {
  title: string;
  date: Date;
  description?: string;
  emoji?: string;
  section?: string;
  sectionHref?: string;
  standardRkey?: string;
  standardPublication?: keyof typeof PUBLICATIONS;
}

const { title, date, description, emoji, section, sectionHref, standardRkey, standardPublication } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<Base title={title} description={description} standardRkey={standardRkey} standardPublication={standardPublication}>
  <article class="h-entry" data-pagefind-body>
    <h1 class="p-name mb-4 text-black dark:text-white font-semibold">{emoji && `${emoji} `}{title}</h1>
    <a class="u-url hidden" href={canonical}>{canonical}</a>
    <AuthorCard />
    <div class="e-content prose dark:prose-invert max-w-none mb-4">
      <slot />
    </div>
    <Divider />
    <div class="mb-4 text-sm">
      {section && sectionHref ? (
        <Fragment>
          Posted in <a href={sectionHref} class="underline">{section}</a>
           on <time class="dt-published" datetime={toISODate(date)} title={formatDateTitle(date)}>{formatDateShort(date)}</time>
        </Fragment>
      ) : (
        <Fragment>
          Posted on <time class="dt-published" datetime={toISODate(date)} title={formatDateTitle(date)}>{formatDateShort(date)}</time>
        </Fragment>
      )}
    </div>
<slot name="nav" />
  </article>
</Base>
