---
import Base from './Base.astro';
import { formatDateTitle, formatDateRelative, isRelativeDate, toISODate } from '@/lib/dates';
import AuthorCard from '@/components/AuthorCard.astro';
import Syndication from '@/components/Syndication.astro';

import type { PUBLICATIONS } from '@/lib/standard-site';

interface Props {
  /** Rendered as-is in the h1 and every head tag — callers fold in any emoji prefix. */
  title: string;
  date: Date;
  description?: string;
  section?: string;
  sectionHref?: string;
  standardRkey?: string;
  standardPublication?: keyof typeof PUBLICATIONS;
  syndication?: string[];
  /** Float the "nav" slot into a right-hand column once there's room for it. */
  navAside?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const { title, date, description, section, sectionHref, standardRkey, standardPublication, syndication, navAside, ogImage, ogImageAlt, ogImageWidth, ogImageHeight } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Below lg the columns collapse and everything stacks in source order, so the
// aside classes are additive — no separate stacked markup needed. items-baseline
// lines the aside's first line up with the body's first line of text; the two
// columns use different font sizes, so matching box tops would leave the smaller
// aside text sitting visibly high.
const columnsClass = navAside ? 'lg:flex lg:items-baseline lg:gap-20' : '';
// Body text is already capped at max-w-140, so cap the column to match rather
// than letting flex-1 stretch it and strand the aside at the far right.
const mainColumnClass = navAside ? 'min-w-0 lg:flex-1 lg:max-w-140' : '';
const asideColumnClass = navAside ? 'lg:w-64 lg:shrink-0' : '';
// Drop "on" for relative phrasing ("Posted 3 days ago") but keep it for absolute
// dates ("Posted on 22 Apr 2026").
const dateConnector = isRelativeDate(date) ? '' : 'on ';
---
<Base title={title} description={description} standardRkey={standardRkey} standardPublication={standardPublication} publishedDate={date} ogImage={ogImage} ogImageAlt={ogImageAlt} ogImageWidth={ogImageWidth} ogImageHeight={ogImageHeight}>
  <article class="h-entry mt-8" data-pagefind-body>
    <h1 class="p-name mb-4 text-black dark:text-white font-semibold">{title}</h1>
    <a class="u-url hidden" href={canonical}>{canonical}</a>
    <AuthorCard />
    <div class={columnsClass}>
      <div class={mainColumnClass}>
        <div class="e-content prose dark:prose-invert max-w-none mb-8">
          <slot />
        </div>
        <div class="text-sm text-gray-500 dark:text-gray-400">
          Posted{section && sectionHref && <Fragment> in <a href={sectionHref} class="underline">{section}</a></Fragment>} {dateConnector}<time class="dt-published" datetime={toISODate(date)} title={formatDateTitle(date)}>{formatDateRelative(date)}</time><Syndication urls={syndication} />.
        </div>
      </div>
      <div class={asideColumnClass}>
        <slot name="nav" />
      </div>
    </div>
  </article>
</Base>
