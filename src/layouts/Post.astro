---
import Base from './Base.astro';
import { formatDateTitle, formatDateShort, toISODate } from '@/lib/dates';
import Divider from '@/components/Divider.astro'

interface Props {
  title: string;
  date: Date;
  description?: string;
  emoji?: string;
  section?: string;
  sectionHref?: string;
}

const { title, date, description, emoji, section, sectionHref } = Astro.props;

---
<Base title={title} description={description}>
  <article class="h-entry" data-pagefind-body>
    <h1 class="p-name mb-4 text-black dark:text-white font-semibold">{emoji && `${emoji} `}{title}</h1>
    <a class="p-author h-card hidden" data-pagefind-ignore rel="author" href="https://barryfrost.com">
      <img class="u-photo" src="https://barryfrost.com/barryfrost.jpg" alt="Barry Frost" />
      <span class="p-name">Barry Frost</span>
      <span class="u-url">https://barryfrost.com</span>
    </a>
    <div class="e-content prose dark:prose-invert max-w-none mb-4">
      <slot />
    </div>
    <Divider />
    <div class="mb-4 text-sm">
      {section && sectionHref ? (
        <Fragment>
          Posted in <a href={sectionHref} class="underline">{section}</a>
           on <time class="dt-published" datetime={toISODate(date)} title={formatDateTitle(date)}>{formatDateShort(date)}</time>
        </Fragment>
      ) : (
        <Fragment>
          Posted on <time class="dt-published" datetime={toISODate(date)} title={formatDateTitle(date)}>{formatDateShort(date)}</time>
        </Fragment>
      )}
    </div>
<slot name="nav" />
  </article>
</Base>
