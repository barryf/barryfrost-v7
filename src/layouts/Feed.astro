---
import Base from './Base.astro';
import Pagination from '@/components/Pagination.astro';

interface Props {
  title: string;
  description: string;
  currentPage?: number;
  totalPages: number;
  basePath: string;
  paginate?: boolean;
}

const { title, currentPage = 1, totalPages, basePath, paginate = true } = Astro.props;
const pageTitle = currentPage > 1 ? `${title} (Page ${currentPage})` : title;
const hasDescription = Astro.slots.has('description');
---
<Base title={pageTitle}>
  <div class="h-feed">
    <div class="h-card p-author hidden">
      <img class="u-photo" src={new URL('/barryfrost.jpg', Astro.url).href} alt="Barry Frost" width="192" height="192" />
      <a class="p-name u-url" href={Astro.site?.href}>Barry Frost</a>
    </div>
    <h1 class={`${hasDescription ? 'mb-4' : 'mb-8'} font-semibold text-black dark:text-white`}>
      {title}{currentPage > 1 && <span class="font-normal"> (Page {currentPage})</span>}
    </h1>
    {hasDescription && (
      <div class="mb-8 text-gray-600 dark:text-gray-400">
        <slot name="description" />
      </div>
    )}
    <slot />
  </div>
  {paginate && <Pagination currentPage={currentPage} totalPages={totalPages} basePath={basePath} />}
</Base>
