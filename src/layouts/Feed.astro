---
import Base from './Base.astro';
import Pagination from '@/components/Pagination.astro';
import AuthorCard from '@/components/AuthorCard.astro';

interface Props {
  title: string;
  /**
   * Plain-text description for the <head> meta tags. Separate from the `description`
   * slot below, which is the rich visible intro copy shown on the page.
   */
  description?: string;
  currentPage?: number;
  totalPages: number;
  basePath: string;
  paginate?: boolean;
  /** Set false to hide the description slot, e.g. on pages after the first. */
  showDescription?: boolean;
}

const { title, description, currentPage = 1, totalPages, basePath, paginate = true, showDescription = true } = Astro.props;
const pageTitle = currentPage > 1 ? `${title} (Page ${currentPage})` : title;
const hasDescription = Astro.slots.has('description') && showDescription;
---
<Base title={pageTitle} description={description}>
  <div class="h-feed">
    <AuthorCard />
    <h1 class={`${hasDescription ? 'mb-4' : 'mb-8'} font-semibold text-black dark:text-white`}>
      {title}{currentPage > 1 && <span class="font-normal"> (Page {currentPage})</span>}
    </h1>
    {hasDescription && (
      <div class="mb-8 text-gray-600 dark:text-gray-400">
        <slot name="description" />
      </div>
    )}
    <slot />
  </div>
  {paginate && <Pagination currentPage={currentPage} totalPages={totalPages} basePath={basePath} />}
</Base>
