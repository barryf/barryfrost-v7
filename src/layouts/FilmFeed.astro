---
import Feed from './Feed.astro';
import FilmCard from '@/components/posts/FilmCard.astro';

interface FilmEntry {
  id: string;
  data: {
    title: string;
    creativeWorkType: string;
    rating?: number;
    posterUrl?: string;
    createdAt: string;
  }
}

interface Props {
  items: FilmEntry[];
  currentPage: number;
  totalPages: number;
  basePath?: string;
  sort?: 'date' | 'rating';
}

const { items, currentPage, totalPages, basePath = '/films', sort = 'date' } = Astro.props;
---
<Feed title="Films" currentPage={currentPage} totalPages={totalPages} basePath={basePath}>
  <Fragment slot="description">
    Films and TV shows I've watched and rated on
    <a href="https://popfeed.social/profile/did:plc:j5ksi3y4tdtbp7vpsxsfyask" class="underline" rel="noopener noreferrer">Popfeed</a>.
  </Fragment>
  <div class="mb-8 flex gap-4 text-sm">
    {sort === 'date' ? (
      <span class="font-semibold">By date</span>
    ) : (
      <a href="/films" class="underline">By date</a>
    )}
    {sort === 'rating' ? (
      <span class="font-semibold">By rating</span>
    ) : (
      <a href="/films/by-rating" class="underline">By rating</a>
    )}
  </div>
  <div class="mb-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-6">
    {items.map(entry => <FilmCard entry={entry} />)}
  </div>
</Feed>
