---
import Base from './Base.astro';
import FilmCard from '@/components/posts/FilmCard.astro';
import Pagination from '@/components/Pagination.astro';
import Divider from '@/components/Divider.astro';

interface FilmEntry {
  id: string;
  data: {
    title: string;
    creativeWorkType: string;
    rating?: number;
    posterUrl?: string;
    createdAt: string;
  }
}

interface Props {
  title: string;
  description?: string;
  items: FilmEntry[];
  currentPage: number;
  totalPages: number;
  basePath?: string;
  sort?: 'date' | 'rating';
}

const { title, description, items, currentPage, totalPages, basePath, sort = 'date' } = Astro.props;
---
<Base title={title} description={description}>
  <h1 class="mb-4 font-semibold text-black dark:text-white">Films</h1>
  <p class="mb-4 text-gray-600 dark:text-gray-400">
    Films and TV shows I've watched and rated on
    <a href="https://popfeed.social/profile/did:plc:j5ksi3y4tdtbp7vpsxsfyask" class="underline" rel="noopener noreferrer">Popfeed</a>.
  </p>
  <Divider />
  <div class="mb-4 flex gap-4">
    {sort === 'date' ? (
      <span class="font-semibold">By date</span>
    ) : (
      <a href="/films" class="underline">By date</a>
    )}
    {sort === 'rating' ? (
      <span class="font-semibold">By rating</span>
    ) : (
      <a href="/films/by-rating" class="underline">By rating</a>
    )}
  </div>
  <div class="mb-4">—</div>
  <div class="h-feed mb-4">
    <div class="h-card p-author hidden">
      <img class="u-photo" src={new URL('/barryfrost.jpg', Astro.url).href} alt="Barry Frost" width="192" height="192" />
      <a class="p-name u-url" href={Astro.site?.href}>Barry Frost</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-6">
      {items.map(entry => (
        <FilmCard entry={entry} />
      ))}
    </div>
  </div>
  <div class="mb-4">—</div>
  <Pagination currentPage={currentPage} totalPages={totalPages} basePath={basePath} />
</Base>
