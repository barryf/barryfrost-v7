---
import Feed from '@/layouts/Feed.astro';
import BlueskyCard from '@/components/posts/BlueskyCard.astro';
import Divider from '@/components/Divider.astro';
import { getFeedPages } from '@/lib/feed';

export async function getStaticPaths() {
  const pages = await getFeedPages('blueskyPosts');
  return pages.slice(1).map(({ page, items, totalPages }) => ({
    params: { page: String(page) },
    props: { items, currentPage: page, totalPages },
  }));
}

const { items, currentPage, totalPages } = Astro.props;
---
<Feed title="Posts" currentPage={currentPage} totalPages={totalPages} basePath="/posts">
  <div class="mb-4">
    {(items as any[]).map((entry, i) => (
      <>
        <BlueskyCard entry={entry} />
        {i < items.length - 1 && <Divider />}
      </>
    ))}
  </div>
</Feed>
