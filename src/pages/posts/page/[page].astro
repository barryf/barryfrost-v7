---
import Base from '@/layouts/Base.astro';
import BlueskyCard from '@/components/posts/BlueskyCard.astro';
import Pagination from '@/components/Pagination.astro';
import { getCollection } from 'astro:content';
import { paginateItems } from '@/lib/feed';

export async function getStaticPaths() {
  const allPosts = (await getCollection('blueskyPosts'))
    .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime());
  const pages = paginateItems(allPosts);
  return pages.slice(1).map(({ page, items, totalPages }) => ({
    params: { page: String(page) },
    props: { items, currentPage: page, totalPages },
  }));
}

const { items, currentPage, totalPages } = Astro.props;
---
<Base title={`Posts (Page ${currentPage})`}>
  <h1 class="mb-8 font-semibold text-black dark:text-white">
    Posts
    <span class="mb-4 font-normal">(Page {currentPage})</span>
  </h1>
  <div class="mb-4">
    {(items as any[]).map((entry, i) => (
      <>
        <BlueskyCard entry={entry} />
        {i < items.length - 1 && <div class="mb-4">—</div>}
      </>
    ))}
  </div>
  <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/posts" />
</Base>
