---
import Feed from '../../../layouts/Feed.astro';
import { getUnifiedFeed, filterByTag, getTags, paginateItems } from '../../../lib/feed';

export async function getStaticPaths() {
  const allItems = await getUnifiedFeed();
  const tags = getTags(allItems);

  return tags.map((tag) => {
    const items = filterByTag(allItems, tag);
    const pages = paginateItems(items);
    const { totalPages } = pages[0] ?? { totalPages: 1 };
    return {
      params: { tag },
      props: { items: pages[0]?.items ?? [], totalPages, tag },
    };
  });
}

const { items, totalPages, tag } = Astro.props;
---
<Feed title={`#${tag}`} items={items} currentPage={1} totalPages={totalPages} basePath={`/tags/${tag}`}>
  <h1 slot="header" class="text-2xl font-bold mb-8">#{tag}</h1>
</Feed>
