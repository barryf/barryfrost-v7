---
import Feed from '@/layouts/Feed.astro';
import CheckInCard from '@/components/posts/CheckInCard.astro';
import { getFeedPages } from '@/lib/feed';

export async function getStaticPaths() {
  const pages = await getFeedPages('check-ins');
  return pages.slice(1).map(({ page, items, totalPages }) => ({
    params: { page: String(page) },
    props: { items, currentPage: page, totalPages },
  }));
}

const { items, currentPage, totalPages } = Astro.props;
---
<Feed title="Check-ins" currentPage={currentPage} totalPages={totalPages} basePath="/check-ins">
  <div class="mb-4 flex flex-col gap-y-4">
    {items.map((entry: any) => <CheckInCard entry={entry} />)}
  </div>
</Feed>
