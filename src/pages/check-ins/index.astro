---
import Feed from '@/layouts/Feed.astro';
import CheckInCard from '@/components/posts/CheckInCard.astro';
import CheckInMap from '@/components/CheckInMap.astro';
import { getCollection } from 'astro:content';
import { paginateItems } from '@/lib/feed';

const allCheckIns = (await getCollection('check-ins'))
  .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime());

const pages = paginateItems(allCheckIns);
const { items, totalPages } = pages[0] ?? { items: [], totalPages: 1 };

const mapCheckIns = allCheckIns
  .filter(c => c.data.latitude && c.data.longitude)
  .map(c => ({
    venueName: c.data.venueName,
    latitude: c.data.latitude!,
    longitude: c.data.longitude!,
    venueCategory: c.data.venueCategory,
    createdAt: c.data.createdAt,
    url: `https://www.openstreetmap.org/?mlat=${c.data.latitude}&mlon=${c.data.longitude}&zoom=17`,
  }));
---
<Feed title="Check-ins" totalPages={totalPages} basePath="/check-ins">
  <Fragment slot="description">
    Places I've checked in to, via <a href="https://foursquare.com" class="underline">Foursquare</a> and <a href="https://www.beaconbits.app/passport/barryfrost.com" class="underline">Beaconbits</a>.
  </Fragment>
  {mapCheckIns.length > 0 && (
    <div class="mb-8 -ml-4 -mr-4 sm:-ml-8 sm:-mr-8">
      <CheckInMap checkIns={mapCheckIns} />
    </div>
  )}
  <div class="flex flex-col gap-y-4">
    {items.map(entry => <CheckInCard entry={entry} />)}
  </div>
</Feed>
