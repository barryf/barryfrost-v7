---
import Base from '@/layouts/Base.astro';
import PhotoCard from '@/components/posts/PhotoCard.astro';
import Pagination from '@/components/Pagination.astro';
import { getCollection } from 'astro:content';
import { paginateItems } from '@/lib/feed';

export async function getStaticPaths() {
  const allPhotos = (await getCollection('photos'))
    .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime());
  const pages = paginateItems(allPhotos);
  return pages.slice(1).map(({ page, items, totalPages }) => ({
    params: { page: String(page) },
    props: { items, currentPage: page, totalPages },
  }));
}

const { items, currentPage, totalPages } = Astro.props;
---
<Base title={`Photos — Page ${currentPage}`}>
  <h1 class="mb-4 text-3xl text-center font-semibold">Photos</h1>
  <h2 class="mb-16 text-sm text-center text-gray-600 dark:text-gray-400">Page {currentPage}</h2>
  <div class="mb-16 flex flex-col gap-y-8">
    {items.map((entry: any) => <PhotoCard entry={entry} />)}
  </div>
  <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/photos" />
</Base>
