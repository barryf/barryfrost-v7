---
import Feed from '@/layouts/Feed.astro';
import PhotoCard from '@/components/posts/PhotoCard.astro';
import { getFeedPages } from '@/lib/feed';
import { SECTIONS } from '@/lib/sections';

export async function getStaticPaths() {
  const pages = await getFeedPages('photos');
  return pages.slice(1).map(({ page, items, totalPages }) => ({
    params: { page: String(page) },
    props: { items, currentPage: page, totalPages },
  }));
}

const { items, currentPage, totalPages } = Astro.props;
---
<Feed {...SECTIONS.photos} currentPage={currentPage} totalPages={totalPages} basePath="/photos">
  <div class="mb-4 flex flex-col gap-y-8">
    {items.map((entry: any) => <PhotoCard entry={entry} />)}
  </div>
</Feed>
