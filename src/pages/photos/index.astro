---
import Feed from '@/layouts/Feed.astro';
import PhotoCard from '@/components/posts/PhotoCard.astro';
import { getFeedPages } from '@/lib/feed';

const pages = await getFeedPages('photos');
const { items, totalPages } = pages[0] ?? { items: [], totalPages: 1 };
---
<Feed title="Photos" totalPages={totalPages} basePath="/photos">
  <Fragment slot="description">
    Photo galleries I've posted on <a href="https://grain.social" class="underline">Grain</a>.
  </Fragment>
  <div class="mb-4 flex flex-col gap-y-8">
    {items.map(entry => <PhotoCard entry={entry} />)}
  </div>
</Feed>
