---
import type { GetStaticPathsOptions, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Feed from '@/layouts/Feed.astro';
import PhotoCard from '@/components/posts/PhotoCard.astro';
import GrainIcon from '@/components/icons/GrainIcon.astro';
import { getFeedEntries, PAGE_SIZE } from '@/lib/feed';
import { SECTIONS } from '@/lib/sections';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const entries = await getFeedEntries('photos');
  return paginate(entries, { pageSize: PAGE_SIZE });
}

interface Props {
  page: Page<CollectionEntry<'photos'>>;
}

const { page } = Astro.props;
---
<Feed {...SECTIONS.photos} currentPage={page.currentPage} totalPages={page.lastPage} basePath="/photos" showDescription={page.currentPage === 1}>
  <Fragment slot="description">
    Photo galleries that I've uploaded to my
    <a href="https://grain.social/profile/barryfrost.com" class="underline">
      <GrainIcon class="inline size-4 align-text-bottom mr-0.5" />Grain account</a>.
  </Fragment>
  <div class="mb-4 flex flex-col gap-y-8">
    {page.data.map(entry => <PhotoCard entry={entry} />)}
  </div>
</Feed>
