---
import Base from '@/layouts/Base.astro';
import { formatMonthYear } from '@/lib/dates';
import SectionHeading from '@/components/SectionHeading.astro';
import SifaIcon from '@/components/icons/SifaIcon.astro';
import {
  getSelf,
  getPositions,
  getEducation,
  getCertifications,
  getSkills,
  getLanguages,
  parseYM,
} from '@/lib/sifa';

const [self, positions, education, certifications, skills, languages] = await Promise.all([
  getSelf(),
  getPositions(),
  getEducation(),
  getCertifications(),
  getSkills(),
  getLanguages(),
]);

const headline = self?.headline;
// The Sifa `about` field is plain text with blank-line paragraph breaks.
const about = self?.about?.trim().split(/\n\s*\n/).map(p => p.trim()).filter(Boolean) ?? [];

type SkillCategory = 'technical' | 'business' | 'interpersonal';
const skillsByCategory = skills.reduce<Record<SkillCategory, string[]>>(
  (acc, s) => {
    const cat = s.category ?? 'technical';
    if (!acc[cat]) acc[cat] = [];
    acc[cat].push(s.name);
    return acc;
  },
  { technical: [], business: [], interpersonal: [] },
);

const proficiencyLabel: Record<string, string> = {
  native: 'Native',
  limited_working: 'Limited working',
  professional_working: 'Professional working',
  full_professional: 'Full professional',
  elementary: 'Elementary',
};
---

<Base title="Work" description="Barry Frost's work history, skills and projects">
  <div data-pagefind-body>
  <SectionHeading title="Work" class="mb-4" />
  <div class="mb-8">
    My career history, education, credentials, skills and languages, from my
    <a href="https://sifa.id/p/barryfrost.com" class="underline text-nowrap"><SifaIcon class="inline size-4 align-text-bottom mx-1" />Sifa profile</a>.
    Connect with me on Sifa or on
    <a href="https://linkedin.com/in/barryfrost" class="underline">LinkedIn</a>.
  </div>

  {(headline || about.length > 0) && (
    <section class="mb-8">
      <h2 class="font-semibold mb-4 text-black dark:text-white">About</h2>
      <div class="space-y-4">
        {headline && <p class="font-medium text-gray-700 dark:text-gray-300">{headline}</p>}
        {about.map(para => <p>{para}</p>)}
      </div>
    </section>
  )}

  <section class="mb-8">
    <h2 class="font-semibold mb-4 text-black dark:text-white">Experience</h2>
    <ul class="space-y-8">
      {positions.map(pos => (
        <li>
          <div>
            <span class="font-semibold">{pos.title}</span>
            <span class="text-gray-600 dark:text-gray-400"> · {pos.company}</span>
          </div>
          <p class="text-sm text-gray-500 dark:text-gray-400">
            {formatMonthYear(parseYM(pos.startedAt))}–{pos.endedAt ? formatMonthYear(parseYM(pos.endedAt)) : 'Present'}
          </p>
          {pos.description && (
            <p class="mt-2 text-sm text-gray-700 dark:text-gray-300 whitespace-pre-wrap">{pos.description.trim()}</p>
          )}
        </li>
      ))}
    </ul>
  </section>

  {education.length > 0 && (
    <section class="mb-8">
      <h2 class="font-semibold mb-4 text-black dark:text-white">Education</h2>
      <ul class="space-y-4">
          {education.map(edu => (
            <li>
              <span class="font-semibold">{edu.institution}</span>
              <p class="text-sm text-gray-700 dark:text-gray-300 mt-0.5">
                {edu.degree}{edu.fieldOfStudy ? `, ${edu.fieldOfStudy}` : ''}
              </p>
              {edu.endedAt && (
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">
                  {formatMonthYear(parseYM(edu.endedAt))}
                </p>
              )}
            </li>
          ))}
        </ul>
    </section>
  )}

  {certifications.length > 0 && (
    <section class="mb-8">
      <h2 class="font-semibold mb-4 text-black dark:text-white">Credentials</h2>
      <ul class="space-y-4">
        {certifications.map(cert => (
          <li>
            <span>
              {cert.credentialUrl
                ? <a href={cert.credentialUrl} class="underline">{cert.name}</a>
                : cert.name}
            </span>
            <p class="text-sm text-gray-700 dark:text-gray-300 mt-0.5">{cert.authority}</p>
            {cert.issuedAt && (
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">
                {formatMonthYear(parseYM(cert.issuedAt))}{cert.expiresAt ? `–${formatMonthYear(parseYM(cert.expiresAt))}` : ''}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  {(skillsByCategory.technical.length > 0 || skillsByCategory.business.length > 0 || skillsByCategory.interpersonal.length > 0) && (
    <section class="mb-8">
      <h2 class="font-semibold mb-4 text-black dark:text-white">Skills</h2>
      <div class="space-y-4">
          {skillsByCategory.technical.length > 0 && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-2">Technical</h3>
              <div class="flex flex-wrap gap-2">
                {skillsByCategory.technical.map(name => (
                  <span class="px-2 py-0.5 text-sm bg-neutral-100 dark:bg-neutral-800 rounded">{name}</span>
                ))}
              </div>
            </div>
          )}
          {skillsByCategory.business.length > 0 && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-2">Business</h3>
              <div class="flex flex-wrap gap-2">
                {skillsByCategory.business.map(name => (
                  <span class="px-2 py-0.5 text-sm bg-neutral-100 dark:bg-neutral-800 rounded">{name}</span>
                ))}
              </div>
            </div>
          )}
          {skillsByCategory.interpersonal.length > 0 && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-2">Interpersonal</h3>
              <div class="flex flex-wrap gap-2">
                {skillsByCategory.interpersonal.map(name => (
                  <span class="px-2 py-0.5 text-sm bg-neutral-100 dark:bg-neutral-800 rounded">{name}</span>
                ))}
              </div>
            </div>
          )}
      </div>
    </section>
  )}

  {languages.length > 0 && (
    <section class="mb-8">
      <h2 class="font-semibold mb-4 text-black dark:text-white">Languages</h2>
      <ul class="space-y-2">
          {languages.map(lang => (
            <li class="text-sm">
              <span class="font-medium">{lang.name}</span>
              <span class="text-gray-500 dark:text-gray-400"> · {proficiencyLabel[lang.proficiency] ?? lang.proficiency}</span>
            </li>
          ))}
        </ul>
    </section>
  )}
  </div>
</Base>
