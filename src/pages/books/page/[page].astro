---
import Base from '@/layouts/Base.astro';
import BookCard from '@/components/posts/BookCard.astro';
import Pagination from '@/components/Pagination.astro';
import { getCollection } from 'astro:content';
import { paginateItems } from '@/lib/feed';

export async function getStaticPaths() {
  const finishedBooks = (await getCollection('books'))
    .filter(b => b.data.status === 'buzz.bookhive.defs#finished')
    .sort((a, b) => new Date(b.data.finishedAt ?? b.data.createdAt).getTime() - new Date(a.data.finishedAt ?? a.data.createdAt).getTime());
  const pages = paginateItems(finishedBooks);
  return pages.slice(1).map(({ page, items, totalPages }) => ({
    params: { page: String(page) },
    props: { items, currentPage: page, totalPages },
  }));
}

const { items, currentPage, totalPages } = Astro.props;
---
<Base title={`Books — Page ${currentPage}`}>
  <h1 class="mb-4 text-3xl text-center font-semibold">Books</h1>
  <h2 class="mb-8 text-sm text-center text-gray-600 dark:text-gray-400">Read — Page {currentPage}</h2>
  <div class="mb-16 flex flex-col gap-y-4">
    {items.map((entry: any) => <BookCard entry={entry} />)}
  </div>
  <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/books" />
</Base>
