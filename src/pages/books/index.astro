---
import { getCollection } from 'astro:content';
import Feed from '../../layouts/Feed.astro';
import FeedEntry from '../../components/FeedEntry.astro';
import { getUnifiedFeed, paginateItems, type FeedItem } from '../../lib/feed';

const [bookEntries, feed] = await Promise.all([
  getCollection('books'),
  getUnifiedFeed(),
]);

const readingItems: FeedItem[] = bookEntries
  .filter(b => b.data.status === 'buzz.bookhive.defs#reading')
  .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime())
  .map(entry => ({
    type: 'book',
    date: new Date(entry.data.createdAt),
    url: `https://bookhive.buzz/books/${entry.data.hiveId}`,
    title: entry.data.title,
    summary: entry.data.authors,
    id: `book:${entry.id}`,
    data: entry.data as unknown as Record<string, unknown>,
  }));

const allItems = feed.filter(i => i.type === 'book');
const pages = paginateItems(allItems);
const { items, totalPages } = pages[0] ?? { items: [], totalPages: 1 };
---
<Feed title="Books" items={items} currentPage={1} totalPages={totalPages} basePath="/books">
  <h1 slot="header" class="text-2xl font-bold mb-4">Books</h1>
  <p slot="header" class="text-neutral-600 dark:text-neutral-400 mb-6">
    Books I'm currently reading and books I've finished, tracked on my <a href="https://bookhive.buzz/profile/barryfrost.com">Bookhive profile</a>.
  </p>
  {readingItems.length > 0 && (
    <section slot="header" class="mb-6">
      <h2 class="text-lg font-semibold mb-2 pb-2 border-b border-neutral-200 dark:border-neutral-700">Reading</h2>
      {readingItems.map(item => <FeedEntry item={item} />)}
    </section>
  )}
  <h2 slot="header" class="text-lg font-semibold mb-2 pb-2 border-b border-neutral-200 dark:border-neutral-700">Read</h2>
</Feed>
