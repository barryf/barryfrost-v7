---
import Base from '@/layouts/Base.astro';
import BookCard from '@/components/posts/BookCard.astro';
import Pagination from '@/components/Pagination.astro';
import { getCollection } from 'astro:content';
import { paginateItems } from '@/lib/feed';

const allBooks = await getCollection('books');

const readingBooks = allBooks
  .filter(b => b.data.status === 'buzz.bookhive.defs#reading')
  .sort((a, b) => new Date(b.data.startedAt ?? b.data.createdAt).getTime() - new Date(a.data.startedAt ?? a.data.createdAt).getTime());

const finishedBooks = allBooks
  .filter(b => b.data.status === 'buzz.bookhive.defs#finished')
  .sort((a, b) => new Date(b.data.finishedAt ?? b.data.createdAt).getTime() - new Date(a.data.finishedAt ?? a.data.createdAt).getTime());

const pages = paginateItems(finishedBooks);
const { items, totalPages } = pages[0] ?? { items: [], totalPages: 1 };
---
<Base title="Books">
  <div class="h-feed">
    <div class="h-card p-author hidden">
      <img class="u-photo" src={new URL('/barryfrost.jpg', Astro.url).href} alt="Barry Frost" width="192" height="192" />
      <a class="p-name u-url" href={Astro.site?.href}>Barry Frost</a>
    </div>
    <h1 class="mb-4 text-3xl text-center font-semibold">Books</h1>
    <h2 class="mb-16 text-sm text-center text-gray-600 dark:text-gray-400">
      Books I'm currently reading and books I've finished, tracked on my <a href="https://bookhive.buzz/profile/barryfrost.com" class="underline">Bookhive profile</a>.
    </h2>
    {readingBooks.length > 0 && (
      <div class="mb-16">
        <h2 class="mb-4 text-lg font-semibold">Currently Reading</h2>
        <div class="flex flex-col gap-y-4">
          {readingBooks.map(entry => <BookCard entry={entry} />)}
        </div>
      </div>
    )}
    <div class="mb-16">
      <h2 class="mb-4 text-lg font-semibold">Read</h2>
      <div class="flex flex-col gap-y-4">
        {items.map(entry => <BookCard entry={entry} />)}
      </div>
    </div>
  </div>
  <Pagination currentPage={1} totalPages={totalPages} basePath="/books" />
</Base>
