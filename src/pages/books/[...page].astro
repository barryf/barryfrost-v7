---
import type { GetStaticPathsOptions, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Feed from '@/layouts/Feed.astro';
import BookCard from '@/components/posts/BookCard.astro';
import Divider from '@/components/Divider.astro';
import BookHiveIcon from '@/components/icons/BookHiveIcon.astro';
import { getFeedEntries, PAGE_SIZE } from '@/lib/feed';
import { SECTIONS } from '@/lib/sections';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const entries = await getFeedEntries('books', {
    filter: b => b.data.status === 'buzz.bookhive.defs#finished',
    sort: (a, b) => new Date(b.data.finishedAt ?? b.data.createdAt).getTime() - new Date(a.data.finishedAt ?? a.data.createdAt).getTime(),
  });
  return paginate(entries, { pageSize: PAGE_SIZE });
}

interface Props {
  page: Page<CollectionEntry<'books'>>;
}

const { page } = Astro.props;
const isFirstPage = page.currentPage === 1;

// Currently-reading books share page 1 alongside the first page of finished books.
const readingBooks = isFirstPage
  ? (await getFeedEntries('books', {
      filter: b => b.data.status === 'buzz.bookhive.defs#reading',
      sort: (a, b) => new Date(b.data.startedAt ?? b.data.createdAt).getTime() - new Date(a.data.startedAt ?? a.data.createdAt).getTime(),
    }))
  : [];
---
<Feed {...SECTIONS.books} currentPage={page.currentPage} totalPages={page.lastPage} basePath="/books" showDescription={isFirstPage}>
  <Fragment slot="description">
    What I'm currently reading and what I've finished, tracked on my
    <a href="https://bookhive.buzz/profile/barryfrost.com" class="underline text-nowrap">
      <BookHiveIcon class="inline size-4 align-text-bottom mr-0.5" />Bookhive
      account</a>.
  </Fragment>
  {isFirstPage && readingBooks.length > 0 && (
    <>
      <section>
        <h2 class="mb-6 font-semibold text-black dark:text-white">Reading</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-x-8 gap-y-4">
          {readingBooks.map(entry => <BookCard entry={entry} size="lg" />)}
        </div>
      </section>
      <Divider />
    </>
  )}
  <section class="mb-4">
    {isFirstPage && <h2 class="mb-6 font-semibold text-black dark:text-white">Finished</h2>}
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-x-8 gap-y-4">
      {page.data.map(entry => <BookCard entry={entry} />)}
    </div>
  </section>
</Feed>
