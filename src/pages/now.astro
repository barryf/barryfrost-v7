---
import { statSync } from 'node:fs';
import { resolve } from 'node:path';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { formatRelativeDate, formatDate, toISODate } from '@/lib/dates';
import { getCurrentPosition, getSelf, formatLocation } from '@/lib/sifa';
import { DID } from '@/lib/pds';

const nowEntry = await getEntry('pages', 'now');
if (!nowEntry) throw new Error('src/content/pages/now.md not found');
const { Content } = await render(nowEntry);

const nowMdPath = resolve(process.cwd(), 'src/content/pages/now.md');
const lastUpdated = statSync(nowMdPath).mtime;

const [position, self, bookEntries, checkinEntries, weeknoteEntries, filmEntries, albumEntries] = await Promise.all([
  getCurrentPosition(),
  getSelf(),
  getCollection('books'),
  getCollection('checkins'),
  getCollection('weeknotes'),
  getCollection('films'),
  getCollection('albums'),
]);

const locationStr = formatLocation(self);

const currentlyReading = bookEntries
  .filter(b => b.data.status === 'buzz.bookhive.defs#reading')
  .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime());

const latestCheckin = [...checkinEntries].sort(
  (a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime(),
)[0];
const todayKey = new Date().toDateString();
const checkinToday = latestCheckin && new Date(latestCheckin.data.createdAt).toDateString() === todayKey
  ? latestCheckin
  : undefined;

const latestWeeknote = [...weeknoteEntries]
  .filter(e => e.data.visibility !== 'unlisted')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

const latestFilmEntry = filmEntries.sort(
  (a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime()
)[0];
const latestFilm = latestFilmEntry ? {
  url: `https://popfeed.social/review/at:/${DID}/social.popfeed.feed.review/${latestFilmEntry.id}`,
  date: new Date(latestFilmEntry.data.createdAt),
  data: latestFilmEntry.data,
} : undefined;

const recentAlbums = [...albumEntries]
  .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime())
  .slice(0, 10);

function toStars(rating: number): string {
  const stars = rating / 2;
  const full = Math.floor(stars);
  const half = stars % 1 >= 0.5;
  return '★'.repeat(full) + (half ? '½' : '');
}

interface Source {
  label: string;
  url?: string;
}
const sifaSource: Source = { label: 'Sifa', url: 'https://sifa.id' };
const bookhiveSource: Source = { label: 'Bookhive', url: 'https://bookhive.buzz' };
const popfeedSource: Source = { label: 'Popfeed', url: 'https://popfeed.social' };
const rockskySource: Source = { label: 'Rocksky', url: 'https://rocksky.app/profile/barryfrost.com' };
---
<Base title="Now" description={nowEntry.data.description}>
  <article data-pagefind-body>
    <h1 class="mb-4 font-semibold text-black dark:text-white">Now</h1>
    <p class="text-sm text-gray-500 dark:text-gray-500 mb-6">
      Last updated <time datetime={toISODate(lastUpdated)} title={formatDate(lastUpdated)}>{formatRelativeDate(lastUpdated)}</time>
    </p>

    <div class="prose dark:prose-invert max-w-none mb-10">
      <Content />
    </div>

    {(position || locationStr) && (
      <section class="mb-6">
        <div class="flex items-center gap-2 mb-2 pb-2 border-b border-neutral-200 dark:border-neutral-700">
          <h2 class="text-lg font-semibold">Working</h2>
          {sifaSource.url ? (
            <a href={sifaSource.url} class="px-2 py-0.5 text-xs bg-neutral-100 dark:bg-neutral-800 rounded text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">{sifaSource.label}</a>
          ) : (
            <span class="px-2 py-0.5 text-xs bg-neutral-100 dark:bg-neutral-800 rounded text-gray-500">{sifaSource.label}</span>
          )}
        </div>
        {position && (
          <p>
            <span class="font-medium">{position.title}</span>
            <span class="text-gray-600 dark:text-gray-400"> at {position.company}</span>
          </p>
        )}
        {locationStr && (
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">Based in {locationStr}</p>
        )}
      </section>
    )}

    {currentlyReading.length > 0 && (
      <section class="mb-6">
        <h2 class="text-lg font-semibold mb-2 pb-2 border-b border-neutral-200 dark:border-neutral-700">Reading</h2>
        <div class="divide-y divide-neutral-100 dark:divide-neutral-800">
          {currentlyReading.map(book => (
            <div class="py-3 flex items-start gap-3">
              <div class="flex gap-3 flex-1 min-w-0">
                {book.data.coverUrl && (
                  <img
                    src={new URL(book.data.coverUrl, Astro.url).href}
                    alt={`Cover for ${book.data.title}`}
                    width="48"
                    height="72"
                    class="w-12 object-cover rounded shrink-0"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div>
                  {book.data.hiveId ? (
                    <a href={`https://bookhive.buzz/books/${book.data.hiveId}`} class="font-medium hover:underline">{book.data.title}</a>
                  ) : (
                    <span class="font-medium">{book.data.title}</span>
                  )}
                  <p class="text-sm text-gray-600 dark:text-gray-400">by {book.data.authors}</p>
                  <div class="mt-0.5 flex items-center gap-3 text-sm text-gray-500 dark:text-gray-500">
                    <time datetime={toISODate(new Date(book.data.createdAt))} title={formatDate(new Date(book.data.createdAt))}>Started {formatRelativeDate(new Date(book.data.createdAt))}</time>
                    {book.data.hiveId && (
                      <a href={`https://bookhive.buzz/books/${book.data.hiveId}`} class="px-2 py-0.5 text-xs bg-neutral-100 dark:bg-neutral-800 rounded hover:text-gray-700 dark:hover:text-gray-300">Bookhive</a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {recentAlbums.length > 0 && (
      <section class="mb-6">
        <div class="flex items-center gap-2 mb-3 pb-2 border-b border-neutral-200 dark:border-neutral-700">
          <h2 class="text-lg font-semibold">Listening</h2>
          {rockskySource.url ? (
            <a href={rockskySource.url} class="px-2 py-0.5 text-xs bg-neutral-100 dark:bg-neutral-800 rounded text-gray-500 hover:text-gray-700 dark:hover:text-gray-300" rel="noopener noreferrer">{rockskySource.label}</a>
          ) : (
            <span class="px-2 py-0.5 text-xs bg-neutral-100 dark:bg-neutral-800 rounded text-gray-500">{rockskySource.label}</span>
          )}
        </div>
        <div class="overflow-x-auto">
          <div class="flex gap-3">
            {recentAlbums.map(a => (
              <div class="flex-none w-28">
                {a.data.coverUrl && (
                  <img
                    src={new URL(a.data.coverUrl, Astro.url).href}
                    alt={`${a.data.title} by ${a.data.artist}`}
                    width="112"
                    height="112"
                    class="w-28 h-28 aspect-square object-cover rounded shadow-sm"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <p class="mt-1 text-sm font-medium leading-tight truncate" title={a.data.title}>{a.data.title}</p>
                <p class="text-xs text-gray-600 dark:text-gray-400 truncate" title={a.data.artist}>{a.data.artist}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {checkinToday && (() => {
      const td = checkinToday.data as { venueName: string; venueCategory?: string; createdAt: string; latitude?: string; longitude?: string; sourceUrl?: string };
      const checkinUrl = td.latitude && td.longitude
        ? `https://www.openstreetmap.org/?mlat=${td.latitude}&mlon=${td.longitude}&zoom=17`
        : '';
      return (
        <section class="mb-6">
          <h2 class="text-lg font-semibold mb-2 pb-2 border-b border-neutral-200 dark:border-neutral-700">Checked in today</h2>
          <div class="flex items-start gap-3">
            <div>
              <p>
                {checkinUrl ? (
                  <a href={checkinUrl} class="font-medium hover:underline" rel="noopener noreferrer">
                    {td.venueName}
                  </a>
                ) : (
                  <span class="font-medium">{td.venueName}</span>
                )}
                {td.venueCategory && (
                  <span class="text-sm text-gray-600 dark:text-gray-400"> · {td.venueCategory}</span>
                )}
              </p>
              <div class="mt-0.5 flex items-center gap-3 text-sm text-gray-500 dark:text-gray-500">
                <time datetime={toISODate(new Date(td.createdAt))} title={formatDate(new Date(td.createdAt))}>{formatRelativeDate(new Date(td.createdAt))}</time>
                {td.sourceUrl && <a href={td.sourceUrl} class="px-2 py-0.5 text-xs bg-neutral-100 dark:bg-neutral-800 rounded hover:text-gray-700 dark:hover:text-gray-300" rel="noopener noreferrer">Beaconbits</a>}
              </div>
            </div>
          </div>
        </section>
      );
    })()}

    {latestWeeknote && (
      <section class="mb-6">
        <h2 class="text-lg font-semibold mb-2 pb-2 border-b border-neutral-200 dark:border-neutral-700">Weeknoting</h2>
        <div class="flex items-start gap-3">
          <div>
            <a href={`/weeknotes/${latestWeeknote.id}`} class="font-medium hover:underline">
              {latestWeeknote.data.emoji && `${latestWeeknote.data.emoji} `}{latestWeeknote.data.title}
            </a>
            <div class="mt-0.5 text-sm text-gray-500 dark:text-gray-500">
              <time datetime={toISODate(latestWeeknote.data.date)} title={formatDate(latestWeeknote.data.date)}>{formatRelativeDate(latestWeeknote.data.date)}</time>
            </div>
          </div>
        </div>
      </section>
    )}

    {latestFilm && (() => {
      const filmData = latestFilm.data as { title: string; rating?: number; posterUrl?: string };
      return (
        <section class="mb-6">
          <h2 class="text-lg font-semibold mb-2 pb-2 border-b border-neutral-200 dark:border-neutral-700">Watching</h2>
          <div class="flex items-start gap-3">
            <div class="flex gap-3 flex-1 min-w-0">
              {filmData.posterUrl && (
                <img
                  src={new URL(filmData.posterUrl, Astro.url).href}
                  alt={`Poster for ${filmData.title}`}
                  width="48"
                  height="72"
                  class="w-12 object-cover rounded shrink-0"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div>
                <a href={latestFilm.url} class="font-medium hover:underline" rel="noopener noreferrer">
                  {filmData.title}
                </a>
                {filmData.rating !== undefined && (
                  <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5" title={`${filmData.rating}/10`}>
                    {toStars(filmData.rating)}
                  </p>
                )}
                <div class="mt-0.5 flex items-center gap-3 text-sm text-gray-500 dark:text-gray-500">
                  <time datetime={toISODate(latestFilm.date)} title={formatDate(latestFilm.date)}>{formatRelativeDate(latestFilm.date)}</time>
                  <a href={popfeedSource.url} class="px-2 py-0.5 text-xs bg-neutral-100 dark:bg-neutral-800 rounded hover:text-gray-700 dark:hover:text-gray-300">{popfeedSource.label}</a>
                </div>
              </div>
            </div>
          </div>
        </section>
      );
    })()}
  </article>
</Base>
