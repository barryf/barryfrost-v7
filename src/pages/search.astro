---
import Base from '@/layouts/Base.astro';
const isDev = import.meta.env.DEV;
---
<Base title="Search">
  <h1 class="mb-8 font-semibold text-black dark:text-white">Search</h1>
  <input
    id="search-input"
    type="search"
    name="q"
    placeholder="Search…"
    autocomplete="off"
    class="w-full rounded border border-gray-400 dark:border-gray-600 bg-white dark:bg-black text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-500 px-3 py-1.5 mb-6 focus:outline-none focus:ring-1 focus:ring-gray-400 dark:focus:ring-gray-600"
  />
  <div id="search-results"></div>
</Base>

<script is:inline define:vars={{ isDev }}>
  (function () {
    var input = document.getElementById('search-input');
    var resultsEl = document.getElementById('search-results');
    if (!input || !resultsEl) return;

    var params = new URLSearchParams(window.location.search);
    input.value = params.get('q') || '';

    var pagefind;
    var debounceTimer;

    function escapeHtml(s) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;')
              .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    async function loadPagefind() {
      if (pagefind || isDev) return;
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.options({ excerptLength: 25 });
    }

    async function runSearch(query) {
      query = query.trim();
      if (!query) {
        resultsEl.innerHTML = '';
        return;
      }
      await loadPagefind();
      if (!pagefind) {
        resultsEl.innerHTML = '<div class="text-sm text-gray-500 dark:text-gray-400">Search is not available in dev mode. Use <code>npm run build &amp;&amp; npm run preview</code> to test.</div>';
        return;
      }
      var search = await pagefind.search(query);
      if (!search.results.length) {
        resultsEl.innerHTML = '<p class="text-sm text-gray-500 dark:text-gray-400">No results for “' + escapeHtml(query) + '”.</p>';
        return;
      }
      var hits = await Promise.all(search.results.map(function (r) { return r.data(); }));
      var fragment = '#:~:text=' + encodeURIComponent(query);
      var html = '<p class="text-sm text-gray-500 dark:text-gray-500 mb-8">' + hits.length + ' result' + (hits.length === 1 ? '' : 's') + '</p>';
      html += hits.map(function (hit) {
        var url = hit.url.replace(/\.html$/, '');
        var title = escapeHtml((hit.meta && hit.meta.title) ? hit.meta.title : url);
        return '<article class="mb-8">'
          + '<a href="' + url + fragment + '" class="underline">' + title + '</a>'
          + (hit.excerpt ? '<p class="text-gray-600 dark:text-gray-400 mt-1">' + hit.excerpt + '</p>' : '')
          + '<p class="text-sm text-gray-500 dark:text-gray-500 mt-1">' + url + '</p>'
          + '</article>';
      }).join('');
      resultsEl.innerHTML = html;
    }

    if (input.value) runSearch(input.value);

    input.addEventListener('input', function () {
      clearTimeout(debounceTimer);
      var query = input.value;
      var url = new URL(window.location.href);
      if (query.trim()) { url.searchParams.set('q', query); } else { url.searchParams.delete('q'); }
      history.replaceState({}, '', url);
      debounceTimer = setTimeout(function () { runSearch(query); }, 200);
    });
  })();
</script>
