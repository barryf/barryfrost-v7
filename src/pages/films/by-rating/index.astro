---
import FilmFeed from '@/layouts/FilmFeed.astro';
import { getFeedPages } from '@/lib/feed';

const pages = await getFeedPages('films', {
  sort: (a, b) => (b.data.rating ?? -1) - (a.data.rating ?? -1),
  pageSize: 40,
});
const { items, totalPages } = pages[0] ?? { items: [], totalPages: 1 };
---
<FilmFeed items={items} currentPage={1} totalPages={totalPages} basePath="/films/by-rating" sort="rating" />
