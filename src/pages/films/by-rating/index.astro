---
import FilmFeed from '../../../layouts/FilmFeed.astro';
import { getUnifiedFeed, paginateItems } from '../../../lib/feed';

const allItems = (await getUnifiedFeed()).filter(i => i.type === 'film');
const sorted = [...allItems].sort((a, b) => {
  const rA = (a.data as { rating?: number }).rating ?? -1;
  const rB = (b.data as { rating?: number }).rating ?? -1;
  return rB - rA;
});
const pages = paginateItems(sorted, 40);
const { items, totalPages } = pages[0] ?? { items: [], totalPages: 1 };
---
<FilmFeed title="Films" items={items} currentPage={1} totalPages={totalPages} basePath="/films/by-rating" sort="rating" />
