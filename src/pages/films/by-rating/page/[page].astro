---
import FilmFeed from '@/layouts/FilmFeed.astro';
import { getCollection } from 'astro:content';
import { paginateItems } from '@/lib/feed';

export async function getStaticPaths() {
  const allFilms = (await getCollection('films'))
    .sort((a, b) => (b.data.rating ?? -1) - (a.data.rating ?? -1));
  const pages = paginateItems(allFilms, 40);
  return pages.slice(1).map(({ page, items, totalPages }) => ({
    params: { page: String(page) },
    props: { items, currentPage: page, totalPages },
  }));
}

const { items, currentPage, totalPages } = Astro.props;
---
<FilmFeed title={`Films — Page ${currentPage}`} items={items} currentPage={currentPage} totalPages={totalPages} basePath="/films/by-rating" sort="rating" />
