---
import FilmFeed from '@/layouts/FilmFeed.astro';
import { getFeedPages } from '@/lib/feed';

export async function getStaticPaths() {
  const pages = await getFeedPages('films', { pageSize: 40 });
  return pages.slice(1).map(({ page, items, totalPages }) => ({
    params: { page: String(page) },
    props: { items, currentPage: page, totalPages },
  }));
}

const { items, currentPage, totalPages } = Astro.props;
---
<FilmFeed items={items} currentPage={currentPage} totalPages={totalPages} basePath="/films" sort="date" />
