---
import FilmFeed from '@/layouts/FilmFeed.astro';
import { getUnifiedFeed, paginateItems } from '@/lib/feed';

const allItems = (await getUnifiedFeed()).filter(i => i.type === 'film');
const pages = paginateItems(allItems, 40);
const { items, totalPages } = pages[0] ?? { items: [], totalPages: 1 };
---
<FilmFeed title="Films" items={items} currentPage={1} totalPages={totalPages} basePath="/films" sort="date" />
