---
import FilmFeed from '@/layouts/FilmFeed.astro';
import { getCollection } from 'astro:content';
import { paginateItems } from '@/lib/feed';

const allFilms = (await getCollection('films'))
  .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime());

const pages = paginateItems(allFilms, 40);
const { items, totalPages } = pages[0] ?? { items: [], totalPages: 1 };
---
<FilmFeed title="Films" items={items} currentPage={1} totalPages={totalPages} basePath="/films" sort="date" />
