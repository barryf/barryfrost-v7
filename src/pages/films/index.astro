---
import Feed from '../../layouts/Feed.astro';
import { getUnifiedFeed, paginateItems } from '../../lib/feed';

const allItems = (await getUnifiedFeed()).filter(i => i.type === 'film');
const pages = paginateItems(allItems);
const { items, totalPages } = pages[0] ?? { items: [], totalPages: 1 };
---
<Feed title="Films" items={items} currentPage={1} totalPages={totalPages} basePath="/films">
  <p slot="header" class="text-neutral-600 dark:text-neutral-400 mb-6">
    Films and TV shows I've watched and rated on <a href="https://popfeed.social" class="underline hover:text-neutral-900 dark:hover:text-neutral-100">Popfeed</a>.
  </p>
</Feed>
