---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { countryFlag, countryName } from '@/lib/flags';
import { formatMonthKey } from '@/lib/dates';
import Divider from '@/components/Divider.astro';

export async function getStaticPaths() {
  const months = [...(await getCollection('travelblog'))].sort((a, b) =>
    a.id.localeCompare(b.id),
  );
  return months.map((entry, i) => ({
    params: { month: entry.id },
    props: { entry, prev: months[i - 1] ?? null, next: months[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const month = formatMonthKey(entry.id);
const { countries = [], intro } = entry.data;
---
<Base title={`Travelblog: ${month}`} description={intro}>
  <article class="h-entry" data-pagefind-body>
    <header class="mb-12">
      <h1 class="mt-8">
        <a href="/travelblog" class="underline">Travelblog</a> -
        <span class="p-name font-semibold text-black dark:text-white">{month}</span>
      </h1>
      {countries.length ? (
        <p class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-sm text-gray-500 dark:text-gray-400">
          {countries.map((code) => (
            <span class="p-location">{countryFlag(code)} {countryName(code)}</span>
          ))}
        </p>
      ) : null}
      {intro ? (
        <p class="mt-4 text-gray-600 italic dark:text-gray-400">{intro}</p>
      ) : null}
    </header>

    <article class="post mb-8 e-content prose dark:prose-invert max-w-none">
      <Content />
    </article>

    {(prev || next) && (
      <Divider />
      <div class="my-8 flex gap-8 text-sm" data-pagefind-ignore>
        {prev && (
          <div>
            <p class="mb-1 text-gray-500 dark:text-gray-400">Previous</p>
            <a href={`/travelblog/${prev.id}`} class="underline">{formatMonthKey(prev.id)}</a>
          </div>
        )}
        {next && (
          <div>
            <p class="mb-1 text-gray-500 dark:text-gray-400">Next</p>
            <a href={`/travelblog/${next.id}`} class="underline">{formatMonthKey(next.id)}</a>
          </div>
        )}
      </div>
    )}
  </article>
</Base>
