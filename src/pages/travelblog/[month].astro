---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { countryFlag, countryName } from '@/lib/flags';
import { formatMonthKey } from '@/lib/dates';

export async function getStaticPaths() {
  const months = [...(await getCollection('travelblog'))].sort((a, b) =>
    a.id.localeCompare(b.id),
  );
  return months.map((entry, i) => ({
    params: { month: entry.id },
    props: { entry, prev: months[i - 1] ?? null, next: months[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const title = formatMonthKey(entry.id);
const { countries = [], intro } = entry.data;
---
<Base title={`Travelblog — ${title}`}>
  <article class="h-entry" data-pagefind-body>
    <header class="mb-8">
      <p class="text-sm text-gray-500 dark:text-gray-400">
        <a href="/travelblog" class="hover:underline">Travelblog</a>
      </p>
      <h1 class="p-name mt-1 font-semibold text-black dark:text-white">{title}</h1>
      {countries.length ? (
        <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm text-gray-500 dark:text-gray-400">
          {countries.map((code) => (
            <span class="p-location">{countryFlag(code)} {countryName(code)}</span>
          ))}
        </p>
      ) : null}
      {intro ? (
        <p class="mt-3 text-gray-600 italic dark:text-gray-400">{intro}</p>
      ) : null}
    </header>

    <div class="e-content prose dark:prose-invert max-w-none">
      <Content />
    </div>

    <nav class="mt-10 flex justify-between gap-4 border-t border-neutral-100 pt-6 text-sm dark:border-neutral-800">
      {prev ? (
        <a href={`/travelblog/${prev.id}`} class="hover:underline">← {formatMonthKey(prev.id)}</a>
      ) : <span />}
      {next ? (
        <a href={`/travelblog/${next.id}`} class="text-right hover:underline">{formatMonthKey(next.id)} →</a>
      ) : <span />}
    </nav>
  </article>
</Base>
