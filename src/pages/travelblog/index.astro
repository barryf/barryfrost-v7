---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { countryFlag, countryName } from '@/lib/flags';
import { formatMonthKey } from '@/lib/dates';
import { Image } from 'astro:assets';
import harbour from '@/assets/travelblog/me-auckland-harbour.jpg';
import milfordSound from '@/assets/travelblog/milford-sound.jpg';
import glacier from '@/assets/travelblog/glacier.jpg';
import whiteIsland from '@/assets/travelblog/white-island.jpg';
import skyDive from '@/assets/travelblog/sky-dive.jpg';
import meBeach from '@/assets/travelblog/me-beach.jpg';
import beachBus from '@/assets/travelblog/beach-bus.jpg';

const months = [...(await getCollection('travelblog'))].sort((a, b) =>
  a.id.localeCompare(b.id),
);
---
<Base title="Travelblog">
  <h1 class="mb-4 font-semibold text-black dark:text-white">Travelblog</h1>

  <div class="mb-8 flex gap-1 overflow-x-auto">
    <Image src={harbour} alt="A man in black shirt standing in front of Auckland harbour" class="h-48 w-32 shrink-0 rounded-l-xl object-cover object-[calc(50%+10px)_center]" />
    <Image src={milfordSound} alt="Man in grey anorak standing in front of a sound/fjord" class="h-48 w-32 shrink-0 object-cover object-center" />
    <Image src={glacier} alt="Man in warm clothes walking inside a glacier" class="h-48 w-32 shrink-0 object-cover object-center" />
    <Image src={whiteIsland} alt="Man in hard hat standing in front of steam at foot of a volcano." class="h-48 w-32 shrink-0 object-cover object-center" />
    <Image src={skyDive} alt="Two people jumping from a plane flying high above the ground." class="h-48 w-32 shrink-0 object-cover object-[calc(50%+30px)_center]" />
    <Image src={meBeach} alt="Man paddling on a beach holding his shoes with rocks close by." class="h-48 w-32 shrink-0 object-cover object-[calc(50%-10px)_center]" />
    <Image src={beachBus} alt="Man standing next to a yellow bus stopped on a beach." class="h-48 w-32 shrink-0 rounded-r-xl object-cover object-center" />
  </div>

  <article>
    <div class="mb-8 prose dark:prose-invert max-w-none">
      <p>
        In 2000–2001 I spent just over a year travelling my way around
        the world with Sue and my
        <a href="https://bunac.org" class="underline" title="British Universities North America Club">BUNAC</a> group.
        A couple of nights in Bangkok, nine months living
        and working in New Zealand, then Australia, Fiji, Hawaii and the west
        coast of the USA before heading home.
      </p>
      <p>
        These are my notes that I periodically posted online to my travelblog
        from eye-wateringly expensive <em>internet cafés</em>.
        My photos are all a little small and grainy because they were taken on a
        film camera, developed, printed and then scanned in using
        ancient technology.
      </p>
    </div>

    <ul class="mb-8">
      {months.map((month) => (
        <li class="mb-8">
          <a href={`/travelblog/${month.id}`} class="underline">
            {formatMonthKey(month.id)}
          </a>
          {month.data.countries.length ? (
            <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-sm text-gray-500 dark:text-gray-400">
              {month.data.countries.map((code) => (
                <span>{countryFlag(code)} {countryName(code)}</span>
              ))}
            </div>
          ) : null}
          {month.data.intro ? (
            <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{month.data.intro}</p>
          ) : null}
        </li>
      ))}
    </ul>
  </article>
</Base>
