---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { countryFlag } from '@/lib/flags';
import { monthKey, formatMonthKey } from '@/lib/dates';

const entries = await getCollection('travelblog');
const months = await getCollection('travelblogMonths');

const counts = new Map<string, number>();
for (const entry of entries) {
  const key = monthKey(entry.data.date);
  counts.set(key, (counts.get(key) ?? 0) + 1);
}

const list = [...counts.keys()].sort().map((key) => ({
  key,
  title: formatMonthKey(key),
  count: counts.get(key)!,
  meta: months.find((m) => m.id === key)?.data ?? null,
}));

const uniqueCountries = new Set(
  months.flatMap((m) => m.data.countries),
);
---
<Base title="Travelblog">
  <article>
    <h1 class="mb-4 font-semibold text-black dark:text-white">Travelblog</h1>
    <div class="prose dark:prose-invert max-w-none">
      <p>
        In 2000–2001 Sue and I spent a year travelling and working our way around
        the world — a night in Bangkok, nine months living and working in New
        Zealand, then Australia, Fiji, Hawaii and the west coast of the USA before
        heading home.
      </p>
      <p>
        Photos are grainy because they were taken on a film camera, printed,
        scanned and uploaded in internet cafes!
      </p>
    </div>

    <p class="mt-6 text-sm text-gray-500 dark:text-gray-400">
      {entries.length} entries · {uniqueCountries.size} countries · {list.length} months
    </p>

    <ul class="mt-6 divide-y divide-neutral-100 dark:divide-neutral-800">
      {list.map(({ key, title, count, meta }) => (
        <li class="py-4">
          <div class="flex items-baseline justify-between gap-4">
            <a href={`/travelblog/${key}`} class="font-semibold hover:underline">{title}</a>
            <span class="shrink-0 text-sm text-gray-400 dark:text-gray-500">{count} {count === 1 ? 'entry' : 'entries'}</span>
          </div>
          {meta?.countries?.length ? (
            <p class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-sm text-gray-500 dark:text-gray-400">
              {meta.countries.map((country) => (
                <span>{countryFlag(country)} {country}</span>
              ))}
            </p>
          ) : null}
          {meta?.intro ? (
            <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{meta.intro}</p>
          ) : null}
        </li>
      ))}
    </ul>
  </article>
</Base>
