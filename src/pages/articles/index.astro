---
import Feed from '@/layouts/Feed.astro';
import ArticleCard from '@/components/posts/ArticleCard.astro';
import { getFeedPages } from '@/lib/feed';

const pages = await getFeedPages('articles', {
  filter: e => e.data.visibility !== 'unlisted',
  sort: (a, b) => b.data.date.getTime() - a.data.date.getTime(),
});
const { items, totalPages } = pages[0] ?? { items: [], totalPages: 1 };
---
<Feed title="Articles" totalPages={totalPages} basePath="/articles">
  <Fragment slot="description">
    Long-form writing on technology, leadership, and making things.
  </Fragment>
  <ul class="mb-4">
    {items.map(entry => <ArticleCard entry={entry} />)}
  </ul>
</Feed>
