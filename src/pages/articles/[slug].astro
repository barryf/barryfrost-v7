---
import { getCollection, render } from 'astro:content';
import Post from '@/layouts/Post.astro';
import { socialMeta } from '@/lib/social';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const social = await socialMeta(entry);
const description = entry.data.description || social.description;
---
<Post
  title={entry.data.title}
  date={entry.data.date}
  description={description}
  section="Articles"
  sectionHref="/articles"
  standardRkey={entry.data.standardRkey}
  standardPublication="articles"
  ogImage={social.image}
  ogImageAlt={social.imageAlt}
  ogImageWidth={social.imageWidth}
  ogImageHeight={social.imageHeight}
>
  <Content />
</Post>
