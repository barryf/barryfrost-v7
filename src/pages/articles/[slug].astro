---
import { getCollection, render } from 'astro:content';
import Post from '@/layouts/Post.astro';
import { ogCardUrl, articleCardData } from '@/lib/og-store';
import { plainExcerpt } from '@/lib/excerpt';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const ogImage = await ogCardUrl(articleCardData(entry), `/og/articles/${entry.id}.png`);
const description = entry.data.description || plainExcerpt(entry.body ?? '') || undefined;
---
<Post
  title={entry.data.title}
  date={entry.data.date}
  description={description}
  section="Articles"
  sectionHref="/articles"
  standardRkey={entry.data.standardRkey}
  standardPublication="articles"
  ogImage={ogImage}
>
  <Content />
</Post>
