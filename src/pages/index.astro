---
import Base from '@/layouts/Base.astro';
import Divider from '@/components/Divider.astro';
import { getCollection } from 'astro:content';
import { formatRelativeDate, formatDateTitle, toISODate } from '@/lib/dates';
import { truncateBody } from '@/lib/weeknotes';
import { renderRichText } from '@/lib/richtext';
import { HANDLE, pdslsUrl } from '@/lib/pds';
import { blobImage } from '@/lib/image-url';
import BlueskyQuote from '@/components/posts/BlueskyQuote.astro';
import BlueskyIcon from '@/components/icons/BlueskyIcon.astro';
import PdslsIcon from '@/components/icons/PdslsIcon.astro';
import BookHiveIcon from '@/components/icons/BookHiveIcon.astro';
import PopfeedIcon from '@/components/icons/PopfeedIcon.astro';
import RockskyIcon from '@/components/icons/RockskyIcon.astro';
import CheckInIcon from '@/components/icons/CheckInIcon.astro';

const [weeknotes, photos, blueskyPosts, articles, checkIns] = await Promise.all([
  getCollection('weeknotes'),
  getCollection('photos'),
  getCollection('blueskyPosts'),
  getCollection('articles'),
  getCollection('check-ins'),
]);

// Latest weeknote
const latestWeeknote = weeknotes
  .filter(e => e.data.visibility !== 'unlisted')
  .sort((a, b) => b.data.week - a.data.week)[0];

// Recent photos (6 most recent)
const recentPhotos = photos
  .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime())
  .slice(0, 6);

// Latest post (not a reply)
const latestPost = blueskyPosts
  .filter(p => !p.data.reply)
  .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime())[0];

// Featured articles
const featuredArticles = articles
  .filter(e => e.data.featured && e.data.visibility !== 'unlisted')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Recent check-ins (5 most recent)
const recentCheckIns = checkIns
  .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime())
  .slice(0, 5);

const latestPostHtml = latestPost ? renderRichText(latestPost.data.text, latestPost.data.facets as any) : '';
const latestPostUrl = latestPost ? `https://bsky.app/profile/${HANDLE}/post/${latestPost.id}` : '';

---
<Base title="Barry Frost" home={true}>
  <div class="h-card mb-4">
    <h1 class="mb-4 font-semibold text-black dark:text-white">
      <a class="u-url hidden" href="https://barryfrost.com" rel="me"></a>
      <span class="p-name">Barry Frost</span>
    </h1>
    <span class="p-locality hidden">Hertfordshire</span>
    <span class="p-country-name hidden">UK</span>
    <p class="mb-4">I'm a part-time software engineer and full-time technology leader with experience building teams, websites and apps. I live in a village in Hertfordshire, UK, with my wife and two sons.</p>
  </div>

  {latestWeeknote && (
    <>
      <Divider />
      <h2 class="font-semibold text-black dark:text-white">Latest Weeknote</h2>
      <p class="mb-1">
        <a href={`/weeknotes/${latestWeeknote.id}`} class="underline">
          {latestWeeknote.data.emoji && `${latestWeeknote.data.emoji} `}{latestWeeknote.data.title}</a>
        {latestWeeknote.body && (
          <Fragment>{truncateBody(latestWeeknote.body)}</Fragment>
        )}
      </p>
      <div class="mb-4 text-sm"><a href="/weeknotes" class="underline">All Weeknotes</a></div>
    </>
  )}

  {recentPhotos.length > 0 && (
    <>
      <Divider />
      <h2 class="mb-1 font-semibold text-black dark:text-white">Recent Photos</h2>
      <div class="mb-1 overflow-x-auto">
        <div class="flex gap-1">
          {recentPhotos.map((entry, i) => {
            const firstThumb = entry.data.thumbnailUrls[0];
            if (!firstThumb) return null;
            const cid = new URL(firstThumb).searchParams.get('cid') ?? '';
            const fullUrl = blobImage(cid, { width: 1000, height: 1000, fit: 'contain' });
            return (
              <a href={fullUrl} rel="noopener noreferrer" class="flex-none">
                <img
                  src={firstThumb}
                  alt={entry.data.title}
                  width="120"
                  height="120"
                  class:list={[
                    "u-photo w-30 h-30 aspect-square object-cover grayscale hover:grayscale-0 transition delay-0 duration-500 ease-in-out",
                    i === 0 && "rounded-l-xl",
                    i === recentPhotos.length - 1 && "rounded-r-xl"
                  ]}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            );
          })}
        </div>
      </div>
      <div class="mb-4 text-sm"><a href="/photos" class="underline">All Photos</a></div>
    </>
  )}

  {latestPost && (
    <>
      <Divider />
      <h2 class="font-semibold text-black dark:text-white">Latest Post</h2>
      <p class="e-content mb-1 wrap-break-word" set:html={latestPostHtml} />
      {latestPost.data.quotedPost && <BlueskyQuote quotedPost={latestPost.data.quotedPost as any} />}
      <div class="mb-1 text-sm text-gray-500 dark:text-gray-500">
        <time class="mr-1" datetime={toISODate(new Date(latestPost.data.createdAt))} title={formatDateTitle(new Date(latestPost.data.createdAt))}>{formatRelativeDate(new Date(latestPost.data.createdAt))}</time>
        <a href={latestPostUrl} class="underline" rel="noopener noreferrer" aria-label="View on Bluesky"><BlueskyIcon /></a>
        <a class="ml-1 underline" href={pdslsUrl(latestPost.data.uri)} rel="noopener noreferrer" aria-label="View on PDSls"><PdslsIcon /></a>
      </div>
      <div class="mb-4 text-sm">
        <a href="/posts" class="underline">All Posts</a>
      </div>
    </>
  )}

  {featuredArticles.length > 0 && (
    <>
      <Divider />
      <h2 class="mb-1 font-semibold text-black dark:text-white">Featured Articles</h2>
      <ul class="mb-2 flex flex-col gap-2 leading-tight">
        {featuredArticles.map(entry => (
          <li><a href={`/articles/${entry.id}`} class="underline">{entry.data.title}</a></li>
        ))}
      </ul>
      <div class="mb-4 text-sm"><a href="/articles" class="underline">All Articles</a></div>
    </>
  )}

  {recentCheckIns.length > 0 && (
    <>
      <Divider />
      <h2 class="mb-1 font-semibold text-black dark:text-white">Recent Check-ins</h2>
      <ul class="mb-2 flex flex-col gap-2 leading-tight">
        {recentCheckIns.map(entry => {
          const venueUrl = entry.data.venueUri
            ?? (entry.data.latitude && entry.data.longitude
              ? `https://www.openstreetmap.org/?mlat=${entry.data.latitude}&mlon=${entry.data.longitude}&zoom=17`
              : null);
          const date = new Date(entry.data.createdAt);
          return (
            <li>
              <CheckInIcon class="inline w-4 h-4 align-text-bottom" />
              {venueUrl
                ? <a href={venueUrl} class="underline" rel="noopener noreferrer">{entry.data.venueName}</a>
                : <span>{entry.data.venueName}</span>
              }
              <span class="text-sm"> {formatRelativeDate(date)}</span>
            </li>
          );
        })}
      </ul>
      <div class="mb-4 text-sm"><a href="/check-ins" class="underline">All Check-ins</a></div>
    </>
  )}

  <Divider />
  <h2 class="font-semibold text-black dark:text-white">Recent Media</h2>
  <p class="mb-4">
    View the <a href="/books" class="underline"><BookHiveIcon class="inline w-4 h-4 align-text-bottom mr-0.5" />books</a> I'm reading,
    the <a href="/films" class="underline"><PopfeedIcon class="inline w-4 h-4 align-text-bottom mr-0.5" />films</a> I've watched and reviewed,
    and the <a href="/music" class="underline"><RockskyIcon class="inline w-4 h-4 align-text-bottom mr-0.5" />music</a> I've been listening to.
  </p>
</Base>
