---
import Base from '@/layouts/Base.astro';
import Divider from '@/components/Divider.astro';
import { getCollection } from 'astro:content';
import { formatDateShort, formatDateTitle, toISODate } from '@/lib/dates';
import { truncateBody } from '@/lib/weeknotes';
import { DID } from '@/lib/pds';
import PdslsIcon from '@/components/icons/PdslsIcon.astro';
import AuthorCard from '@/components/AuthorCard.astro';
import BlueskyCard from '@/components/posts/BlueskyCard.astro';

const [weeknotes, photos, blueskyPosts, articles, checkIns] = await Promise.all([
  getCollection('weeknotes'),
  getCollection('photos'),
  getCollection('blueskyPosts'),
  getCollection('articles'),
  getCollection('check-ins'),
]);

// Latest weeknote
const latestWeeknote = weeknotes
  .filter(e => e.data.visibility !== 'unlisted')
  .sort((a, b) => b.data.week - a.data.week)[0];

// Recent photos (8 most recent)
const recentPhotos = photos
  .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime())
  .slice(0, 8);

// Latest post (not a reply)
const latestPost = blueskyPosts
  .filter(p => !p.data.reply)
  .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime())[0];

// Featured articles
const featuredArticles = articles
  .filter(e => e.data.featured && e.data.visibility !== 'unlisted')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Recent check-ins (5 most recent)
const recentCheckIns = checkIns
  .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime())
  .slice(0, 5);

---
<Base title="Barry Frost">
  <p class="mb-4">
      I'm a part-time software engineer and full-time technology leader with experience building teams, websites and apps.
      I live in a village in Hertfordshire, UK, with my wife and two sons.
      <a href="/work" class="underline">Work</a>
      <a href="/about" class="underline">About</a>
  </p>

  <p class="mb-4">
    This site is <a href="/colophon" class="underline">built</a> using
    <a class="underline" href="https://atproto.com" title="AT Protocol">atproto</a>.
    Content is stored in my
    <a class="underline text-nowrap" href={`https://pdsls.dev/at://${DID}`} rel="noopener noreferrer" aria-label="View on PDSls">
      <PdslsIcon class="w-3 h-3 inline-block -translate-y-px mr-1" />PDS</a>
      WIP
  </p>

  <p class="mb-4 flex gap-x-3 text-sm">
    <a href="/now" class="underline">Now</a>
    <a href="/uses" class="underline">Uses</a>
  </p>

  <div class="h-feed">
  <data class="p-name hidden">Latest content feed</data>
  <AuthorCard />

  {latestWeeknote && (
    <>
      <Divider />
      <h2 class="font-semibold text-black dark:text-white">Latest Weeknote</h2>
      <div class="h-entry">
        <AuthorCard />
        <h3>
          <a href={`/weeknotes/${latestWeeknote.id}`} class="p-name u-url underline">
            {latestWeeknote.data.emoji && `${latestWeeknote.data.emoji} `}{latestWeeknote.data.title}</a>
        </h3>
        <p class="e-content">
          {latestWeeknote.body && (
            <Fragment>{truncateBody(latestWeeknote.body)}</Fragment>
          )}
        </p>
        <div class="mb-2 text-sm text-gray-500 dark:text-gray-400">
          <time class="dt-published" datetime={toISODate(latestWeeknote.data.date)} title={formatDateTitle(latestWeeknote.data.date)}>{formatDateShort(latestWeeknote.data.date)}</time>
        </div>
      </div>
      <div class="mb-4 text-sm"><a href="/weeknotes" class="underline">All Weeknotes</a></div>
    </>
  )}

  {recentPhotos.length > 0 && (
    <>
      <Divider />
      <h2 class="mb-1 font-semibold text-black dark:text-white">Recent Photos</h2>
      <div class="mb-1 overflow-x-auto">
        <div class="flex gap-1">
          {recentPhotos.map((entry, i) => {
            const firstThumb = entry.data.thumbnailUrls[0];
            if (!firstThumb) return null;
            const grainUrl = `https://grain.social/profile/${DID}/gallery/${entry.data.galleryRkey}`;
            return (
              <div class="h-entry flex-none">
                <AuthorCard />
                <a href={grainUrl} class="u-url" rel="noopener noreferrer">
                  <img
                    src={firstThumb}
                    alt={entry.data.title}
                    width="120"
                    height="120"
                    class:list={[
                      "u-photo size-30 aspect-square object-cover",
                      i === 0 && "rounded-l-xl",
                      i === recentPhotos.length - 1 && "rounded-r-xl"
                    ]}
                    loading={i < 2 ? "eager" : "lazy"}
                    fetchpriority={i < 2 ? "high" : undefined}
                    decoding="async"
                  />
                </a>
                <data class="p-name" value={entry.data.title}></data>
                <time class="dt-published hidden" datetime={toISODate(new Date(entry.data.createdAt))}>{formatDateShort(new Date(entry.data.createdAt))}</time>
              </div>
            );
          })}
        </div>
      </div>
      <div class="mb-4 text-sm"><a href="/photos" class="underline">All Photos</a></div>
    </>
  )}

  {latestPost && (
    <>
      <Divider />
      <h2 class="font-semibold text-black dark:text-white">Latest Post</h2>
      <BlueskyCard entry={latestPost} indexable={false} />
      <div class="mb-4 mt-1 text-sm">
        <a href="/posts" class="underline">All Posts</a>
      </div>
    </>
  )}

  {featuredArticles.length > 0 && (
    <>
      <Divider />
      <h2 class="mb-1 font-semibold text-black dark:text-white">Featured Articles</h2>
      <ul class="mb-2 flex flex-col gap-2 leading-tight">
        {featuredArticles.map(entry => (
          <li class="h-entry">
            <AuthorCard />
            <a href={`/articles/${entry.id}`} class="p-name u-url underline">{entry.data.title}</a>
            <time class="dt-published hidden" datetime={toISODate(entry.data.date)}>{formatDateShort(entry.data.date)}</time>
          </li>
        ))}
      </ul>
      <div class="mb-4 text-sm"><a href="/articles" class="underline">All Articles</a></div>
    </>
  )}

  {recentCheckIns.length > 0 && (
    <>
      <Divider />
      <h2 class="mb-1 font-semibold text-black dark:text-white">Recent Check-ins</h2>
      <ul class="mb-2 flex flex-col gap-2 leading-tight">
        {recentCheckIns.map(entry => {
          const venueUrl = entry.data.venueUri
            ?? (entry.data.latitude && entry.data.longitude
              ? `https://www.openstreetmap.org/?mlat=${entry.data.latitude}&mlon=${entry.data.longitude}&zoom=17`
              : null);
          const date = new Date(entry.data.createdAt);
          return (
            <li class="h-entry">
              <AuthorCard />
              <span class="p-checkin h-card">
                {venueUrl
                  ? <a href={venueUrl} class="p-name u-url underline" rel="noopener noreferrer">{entry.data.venueName}</a>
                  : <span class="p-name">{entry.data.venueName}</span>
                }
                {(entry.data.venueLocality || entry.data.venueRegion) && (
                  <span class="p-adr h-adr hidden">
                    {entry.data.venueLocality && <span class="p-locality">{entry.data.venueLocality}</span>}
                    {entry.data.venueRegion && <span class="p-region">{entry.data.venueRegion}</span>}
                  </span>
                )}
                {entry.data.latitude && <data class="p-latitude" value={entry.data.latitude} />}
                {entry.data.longitude && <data class="p-longitude" value={entry.data.longitude} />}
              </span>
              <data class="p-name hidden">{entry.data.venueName}</data>
              <time class="dt-published text-sm text-gray-500 dark:text-gray-400" datetime={toISODate(date)} title={formatDateTitle(date)}> {formatDateShort(date)}</time>
            </li>
          );
        })}
      </ul>
      <div class="mb-4 text-sm"><a href="/check-ins" class="underline">All Check-ins</a></div>
    </>
  )}
  </div>
</Base>
