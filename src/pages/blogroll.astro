---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import FollowCard from '@/components/FollowCard.astro';
import Divider from '@/components/Divider.astro';

const [blogsRaw, publications] = await Promise.all([
  getCollection('blogroll'),
  getCollection('standardSubscriptions'),
]);

const blogs = blogsRaw.slice().sort((a, b) => a.data.name.localeCompare(b.data.name));
publications.sort((a, b) => a.data.name.localeCompare(b.data.name));
---
<Base title="Blogroll" description="Blogs and publications I follow">
  <h1 class="mb-4 font-semibold text-black dark:text-white">Blogroll</h1>

  <Divider />
  <section class="mb-4">
    <h2 class="mb-4 font-semibold text-black dark:text-white">Blogs</h2>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8">
      {blogs.map(blog => (
        <li class="py-2">
          <FollowCard
            name={blog.data.name}
            description={blog.data.hostname}
            avatarUrl={blog.data.avatarUrl}
            profileUrl={blog.data.url}
            rounded="md"
          />
        </li>
      ))}
    </ul>
  </section>

  {publications.length > 0 && (
    <>
      <Divider />
      <section class="mb-4">
        <h2 class="mb-4 font-semibold text-black dark:text-white">Publications</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8">
          {publications.map(s => (
            <li class="py-2">
              <FollowCard
                name={s.data.name}
                handle={s.data.handle}
                avatarUrl={s.data.iconUrl}
                profileUrl={s.data.siteUrl}
                rounded="md"
              />
            </li>
          ))}
        </ul>
      </section>
    </>
  )}
</Base>
