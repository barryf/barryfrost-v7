---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FollowCard from '../components/FollowCard.astro';
import blogsData from '../data/blogroll.json';
import { downloadImage } from '../lib/download-image';

const publications = await getCollection('standardSubscriptions');
publications.sort((a, b) => a.data.name.localeCompare(b.data.name));

const blogs = await Promise.all(
  blogsData
    .slice()
    .sort((a, b) => a.name.localeCompare(b.name))
    .map(async (blog) => {
      const hostname = new URL(blog.url).hostname;
      const faviconUrl = `https://www.google.com/s2/favicons?domain=${hostname}&sz=96`;
      const avatarUrl = await downloadImage(faviconUrl, 'blogroll', `${hostname}.png`, 48, 48);
      return { ...blog, hostname, avatarUrl };
    })
);
---
<Base title="Blogroll" description="Blogs and publications I follow">
  <h1 class="text-2xl font-bold mb-8">Blogroll</h1>

  <section class="mb-12">
    <h2 class="text-lg font-semibold mb-4">Blogs</h2>
    <ul>
      {blogs.map(blog => (
        <li class="py-4 border-b border-neutral-100 dark:border-neutral-800 last:border-0">
          <FollowCard
            name={blog.name}
            description={blog.hostname}
            avatarUrl={blog.avatarUrl}
            profileUrl={blog.url}
            rounded="md"
          />
        </li>
      ))}
    </ul>
  </section>

  {publications.length > 0 && (
    <section>
      <h2 class="text-lg font-semibold mb-4">Publications</h2>
      <ul>
        {publications.map(s => (
          <li class="py-4 border-b border-neutral-100 dark:border-neutral-800 last:border-0">
            <FollowCard
              name={s.data.name}
              handle={s.data.handle}
              avatarUrl={s.data.iconUrl}
              description={s.data.description}
              profileUrl={s.data.siteUrl}
              rounded="md"
            />
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
