---
import Base from '@/layouts/Base.astro';
import CheckinCard from '@/components/posts/CheckinCard.astro';
import Pagination from '@/components/Pagination.astro';
import { getCollection } from 'astro:content';
import { paginateItems } from '@/lib/feed';

export async function getStaticPaths() {
  const allCheckins = (await getCollection('checkins'))
    .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime());
  const pages = paginateItems(allCheckins);
  return pages.slice(1).map(({ page, items, totalPages }) => ({
    params: { page: String(page) },
    props: { items, currentPage: page, totalPages },
  }));
}

const { items, currentPage, totalPages } = Astro.props;
---
<Base title={`Checkins (Page ${currentPage})`}>
  <h1 class="mb-8 font-semibold text-black dark:text-white">
    Checkins <span class="font-normal">(Page {currentPage})</span>
  </h1>
  <div class="mb-4 flex flex-col gap-y-4">
    {items.map((entry: any) => <CheckinCard entry={entry} />)}
  </div>
  <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/checkins" />
</Base>
