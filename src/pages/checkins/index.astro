---
import Feed from '../../layouts/Feed.astro';
import CheckinMap from '../../components/CheckinMap.astro';
import { getUnifiedFeed, paginateItems } from '../../lib/feed';

const allItems = (await getUnifiedFeed()).filter(i => i.type === 'checkin');
const pages = paginateItems(allItems);
const { items, totalPages } = pages[0] ?? { items: [], totalPages: 1 };

const mapCheckins = allItems
  .filter(i => i.data.latitude && i.data.longitude)
  .map(i => ({
    venueName: i.data.venueName as string,
    latitude: i.data.latitude as string,
    longitude: i.data.longitude as string,
    venueCategory: i.data.venueCategory as string | undefined,
    createdAt: i.data.createdAt as string,
    url: i.url,
  }));
---
<Feed title="Checkins" items={items} currentPage={1} totalPages={totalPages} basePath="/checkins">
  {mapCheckins.length > 0 && <CheckinMap slot="header" checkins={mapCheckins} />}
</Feed>
