---
import Feed from '../../../../layouts/Feed.astro';
import { getUnifiedFeed, filterByCategory, getCategories, paginateItems } from '../../../../lib/feed';

export async function getStaticPaths() {
  const allItems = await getUnifiedFeed();
  const categories = getCategories(allItems);

  return categories.flatMap((category) => {
    const items = filterByCategory(allItems, category);
    const pages = paginateItems(items);
    return pages.slice(1).map(({ page, items, totalPages }) => ({
      params: { category, page: String(page) },
      props: { items, currentPage: page, totalPages, category },
    }));
  });
}

const { items, currentPage, totalPages, category } = Astro.props;
---
<Feed title={`#${category} — Page ${currentPage}`} items={items} currentPage={currentPage} totalPages={totalPages} basePath={`/categories/${category}`}>
  <h1 slot="header" class="text-2xl font-bold mb-8">#{category}</h1>
</Feed>
