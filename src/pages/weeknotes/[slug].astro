---
import { getCollection, render } from 'astro:content';
import Post from '@/layouts/Post.astro';
import { plainExcerpt } from '@/lib/weeknotes';
import Divider from '@/components/Divider.astro';

export async function getStaticPaths() {
  const weeknotes = await getCollection('weeknotes');
  const sorted = [...weeknotes].sort((a, b) => a.data.week - b.data.week);

  return sorted.map((entry, i) => {
    const weekNum = entry.data.week;
    const onThisDay = sorted
      .filter(e => {
        const diff = Math.abs(weekNum - e.data.week);
        return diff > 0 && diff % 52 === 0;
      })
      .sort((a, b) => b.data.week - a.data.week)
      .map(e => ({
        id: e.id,
        title: e.data.title,
        emoji: e.data.emoji,
        year: e.data.date.getFullYear(),
        excerpt: e.body ? plainExcerpt(e.body) : '',
      }));

    return {
      params: { slug: entry.id },
      props: {
        entry,
        prev: sorted[i - 1] ?? null,
        next: sorted[i + 1] ?? null,
        onThisDay,
      },
    };
  });
}

const { entry, prev, next, onThisDay } = Astro.props;
const { Content } = await render(entry);
---
<Post
  title={entry.data.title}
  date={entry.data.date}
  description={entry.data.description}
  emoji={entry.data.emoji}
  section="Weeknotes"
  sectionHref="/weeknotes"
>
  <Content />
  <Fragment slot="nav">
    {(prev || next) && (
      <div class="my-8 flex gap-8 text-sm" data-pagefind-ignore>
        {prev && (
          <div>
            <p class="text-gray-500 dark:text-gray-500 mb-1">Previous</p>
            <span>{prev.data.emoji && `${prev.data.emoji}`}<a href={`/weeknotes/${prev.id}`} class="ml-2 underline">{prev.data.title}</a></span>
          </div>
        )}
        {next && (
          <div>
            <p class="text-gray-500 dark:text-gray-500 mb-1">Next</p>
            <span>{next.data.emoji && `${next.data.emoji}`}<a href={`/weeknotes/${next.id}`} class="ml-2 underline">{next.data.title}</a></span>
          </div>
        )}
      </div>
    )}
    {onThisDay.length > 0 && (
      <aside class="mb-4 text-gray-600 dark:text-gray-400 text-sm" data-pagefind-ignore>
        <h2 class="mb-2 text-gray-500 dark:text-gray-500">Previously this week</h2>
        <ul class="space-y-2">
          {onThisDay.map(e => (
            <li class="flex gap-x-2">
              <span>{e.year}</span>
              {e.emoji && <span>{e.emoji}</span>}
              <a href={`/weeknotes/${e.id}`} class="underline">{e.title}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </Fragment>
</Post>
