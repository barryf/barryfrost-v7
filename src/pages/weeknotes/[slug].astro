---
import { getCollection, render } from 'astro:content';
import Post from '@/layouts/Post.astro';
import Divider from '@/components/Divider.astro';
import { plainExcerpt, weeknoteLabel } from '@/lib/weeknotes';
import { formatDateShort, toISODate } from '@/lib/dates';

export async function getStaticPaths() {
  const weeknotes = await getCollection('weeknotes');
  const sorted = [...weeknotes].sort((a, b) => a.data.week - b.data.week);

  return sorted.map((entry, i) => {
    const weekNum = entry.data.week;
    const onThisDay = sorted
      .filter(e => {
        const diff = Math.abs(weekNum - e.data.week);
        return diff > 0 && diff % 52 === 0;
      })
      .sort((a, b) => b.data.week - a.data.week)
      .map(e => ({
        id: e.id,
        title: e.data.title,
        emoji: e.data.emoji,
        year: e.data.date.getFullYear(),
        excerpt: e.body ? plainExcerpt(e.body) : '',
      }));

    return {
      params: { slug: entry.id },
      props: {
        entry,
        prev: sorted[i - 1] ?? null,
        next: sorted[i + 1] ?? null,
        onThisDay,
      },
    };
  });
}

const { entry, prev, next, onThisDay } = Astro.props;
const { Content } = await render(entry);
---
<Post
  title={entry.data.title}
  date={entry.data.date}
  description={entry.data.description}
  emoji={entry.data.emoji}
  section="Weeknotes"
  sectionHref="/weeknotes"
>
  <Content />
  <Fragment slot="nav">
    {prev && (
      <div class="mb-16 text-sm text-gray-600 dark:text-gray-400" data-pagefind-ignore>
        <span class="mr-1">&larr;</span>
        <a href={`/weeknotes/${prev.id}`} class="underline">{weeknoteLabel(prev)}</a>
      </div>
    )}
    {onThisDay.length > 0 && (
      <aside class="mb-16 text-gray-600 dark:text-gray-400" data-pagefind-ignore>
        <h2 class="mb-4 text-center text-sm">Previously this week</h2>
        <ul class="space-y-4 text-sm">
          {onThisDay.map(e => (
            <li class="flex gap-x-2 justify-center">
              <span>{e.year}</span>
              {e.emoji && <span>{e.emoji}</span>}
              <a href={`/weeknotes/${e.id}`} class="underline">{e.title}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </Fragment>
</Post>
