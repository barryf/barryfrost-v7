---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDateShort, toISODate } from '@/lib/dates';
import { truncateBody } from '@/lib/weeknotes';

const allWeeknotes = await getCollection('weeknotes');
allWeeknotes.sort((a, b) => b.data.week - a.data.week);
const [latestWeeknote, ...restWeeknotes] = allWeeknotes;

function titleWord(title: string): string {
  return title.replace(/^Week \d+\s*[-:]\s*/i, '');
}
---
<Base title="Weeknotes">
  <h1 class="mb-4 text-3xl text-center font-semibold">Weeknotes</h1>
  <h2 class="mb-16 text-sm text-center text-gray-600 dark:text-gray-400">
    Weekly notes about what I've been up to — work, home, sport, reading, watching, and life in general.
  </h2>

  {latestWeeknote && (
    <div class="mb-16">
      <div class="mb-4">
        <h2 class="inline text-lg">Latest</h2>
      </div>
      <div class="text-sm leading-relaxed p-3 rounded-xl border bg-gray-50 dark:bg-gray-900 border-gray-300 dark:border-gray-700">
        <a href={`/weeknotes/${latestWeeknote.id}`} class="underline mr-1">
          {latestWeeknote.data.emoji && `${latestWeeknote.data.emoji} `}{latestWeeknote.data.title}
        </a>
        {latestWeeknote.body && (
          <p class="text-gray-700 dark:text-gray-300 inline">
            {truncateBody(latestWeeknote.body)}
          </p>
        )}
        <div class="mt-2">
          <time class="dt-published text-xs text-gray-500 dark:text-gray-500" datetime={toISODate(latestWeeknote.data.date)}>
            {formatDateShort(latestWeeknote.data.date)}
          </time>
        </div>
      </div>
    </div>
  )}

  <div class="mb-16">
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-1">
      {restWeeknotes.map(entry => (
        <a href={`/weeknotes/${entry.id}`} class="flex items-center gap-1 py-1.5 rounded -mx-1.5 px-1.5 group">
          <span class="font-mono text-gray-400 dark:text-gray-600 text-xs tabular-nums w-6 text-right shrink-0">{entry.data.week}</span>
          <span class="text-base w-6 text-center shrink-0 leading-none">{entry.data.emoji}</span>
          <span class="text-sm group-hover:underline truncate">{titleWord(entry.data.title)}</span>
        </a>
      ))}
    </div>
    <p class="text-xs text-gray-400 dark:text-gray-600 mt-8">{allWeeknotes.length} weeknotes</p>
  </div>
</Base>
