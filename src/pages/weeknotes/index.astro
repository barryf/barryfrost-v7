---
import Base from '@/layouts/Base.astro';
import AuthorCard from '@/components/AuthorCard.astro';
import { getCollection } from 'astro:content';
import { toISODate } from '@/lib/dates';

const allWeeknotes = await getCollection('weeknotes');
allWeeknotes.sort((a, b) => b.data.week - a.data.week);

function titleWord(title: string): string {
  return title.replace(/^Week \d+\s*[-:]\s*/i, '');
}
---
<Base title="Weeknotes">
  <div class="h-feed">
    <AuthorCard />
    <h1 class="mb-4 font-semibold text-black dark:text-white">Weeknotes</h1>
    <div class="mb-8 text-gray-600 dark:text-gray-400">
      Unstructured notes on what I've been up to each week, usually written and
      published on a Sunday evening.
    </div>
    <div class="mb-4">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-x-4 gap-y-1">
        {allWeeknotes.map(entry => (
          <span class="h-entry flex items-center gap-1 py-1.5 rounded -mx-1.5 px-1.5 group">
            <span class="font-mono text-gray-500 dark:text-gray-400 text-xs tabular-nums w-6 text-right shrink-0">{entry.data.week}</span>
            <span class="text-base w-6 text-center shrink-0 leading-none">{entry.data.emoji}</span>
            <a href={`/weeknotes/${entry.id}`} class="u-url underline truncate">{titleWord(entry.data.title)}</a>
            <data class="p-name" value={entry.data.title}></data>
            <time class="dt-published hidden" datetime={toISODate(entry.data.date)}></time>
            <AuthorCard />
          </span>
        ))}
      </div>
    </div>
  </div>
</Base>
