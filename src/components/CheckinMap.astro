---
interface CheckinPoint {
  venueName: string;
  latitude: string;
  longitude: string;
  venueCategory?: string;
  createdAt: string;
  url: string;
}

interface Props {
  checkins: CheckinPoint[];
}

const { checkins } = Astro.props;
---

<div id="checkin-map-container" class="relative w-full mb-4">
  <div id="checkin-map" class="w-full rounded-lg bg-neutral-100 dark:bg-neutral-800 overflow-hidden" style="height: 360px;"></div>
  <button
    id="checkin-map-fullscreen-btn"
    title="Toggle fullscreen"
    aria-label="Toggle fullscreen"
    style="position:absolute;top:8px;right:8px;z-index:1000;background:white;border:1px solid #ccc;border-radius:4px;padding:4px;cursor:pointer;display:flex;align-items:center;justify-content:center;"
  >
    <svg id="checkin-map-expand-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
    </svg>
    <svg id="checkin-map-collapse-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
      <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"/>
    </svg>
  </button>
</div>

<script is:inline define:vars={{ checkins }}>
  (function () {
    function loadCSS(href) {
      const el = document.createElement('link');
      el.rel = 'stylesheet';
      el.href = href;
      document.head.appendChild(el);
    }

    function loadScript(src, cb) {
      const el = document.createElement('script');
      el.src = src;
      el.onload = cb;
      document.head.appendChild(el);
    }

    function initMap() {
      const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const tileUrl = dark
        ? 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png'
        : 'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png';

      const map = L.map('checkin-map');
      L.tileLayer(tileUrl, {
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors ' +
          '&copy; <a href="https://carto.com/attributions">CARTO</a>',
        subdomains: 'abcd',
        maxZoom: 20,
      }).addTo(map);

      const cluster = L.markerClusterGroup();

      for (const c of checkins) {
        const marker = L.marker([parseFloat(c.latitude), parseFloat(c.longitude)]);
        const date = new Date(c.createdAt).toLocaleDateString('en-GB', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        });
        marker.bindPopup(
          '<strong><a href="' + c.url + '">' + c.venueName + '</a></strong>' +
          (c.venueCategory ? '<br><span style="font-size:0.85em">' + c.venueCategory + '</span>' : '') +
          '<br><small>' + date + '</small>'
        );
        cluster.addLayer(marker);
      }

      map.addLayer(cluster);

      if (checkins.length > 0) {
        map.fitBounds(cluster.getBounds(), { padding: [30, 30] });
      } else {
        map.setView([51.5, -0.1], 10);
      }

      var container = document.getElementById('checkin-map-container');
      var mapEl = document.getElementById('checkin-map');
      var btn = document.getElementById('checkin-map-fullscreen-btn');
      var expandIcon = document.getElementById('checkin-map-expand-icon');
      var collapseIcon = document.getElementById('checkin-map-collapse-icon');
      var isFullscreen = false;

      function enterFullscreen() {
        isFullscreen = true;
        container.style.cssText = 'position:fixed;inset:0;z-index:9999;margin:0;';
        mapEl.style.height = '100dvh';
        mapEl.style.borderRadius = '0';
        expandIcon.style.display = 'none';
        collapseIcon.style.display = '';
        btn.title = 'Exit fullscreen';
        btn.setAttribute('aria-label', 'Exit fullscreen');
        document.body.style.overflow = 'hidden';
        map.invalidateSize();
      }

      function exitFullscreen() {
        isFullscreen = false;
        container.style.cssText = '';
        mapEl.style.height = '360px';
        mapEl.style.borderRadius = '';
        expandIcon.style.display = '';
        collapseIcon.style.display = 'none';
        btn.title = 'Toggle fullscreen';
        btn.setAttribute('aria-label', 'Toggle fullscreen');
        document.body.style.overflow = '';
        map.invalidateSize();
      }

      btn.addEventListener('click', function () {
        if (isFullscreen) exitFullscreen(); else enterFullscreen();
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && isFullscreen) exitFullscreen();
      });
    }

    loadCSS('https://unpkg.com/leaflet@1.9.4/dist/leaflet.css');
    loadCSS('https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css');
    loadCSS('https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css');
    loadScript('https://unpkg.com/leaflet@1.9.4/dist/leaflet.js', function () {
      loadScript('https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js', initMap);
    });
  })();
</script>
