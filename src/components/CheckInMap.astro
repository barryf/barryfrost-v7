---
interface CheckInPoint {
  venueName: string;
  latitude: string;
  longitude: string;
  venueCategory?: string;
  createdAt: string;
  url: string;
}

interface Props {
  checkIns: CheckInPoint[];
}

const { checkIns } = Astro.props;
---

<div id="check-in-map-container" class="relative w-full mb-4">
  <div id="check-in-map" class="w-full bg-neutral-100 dark:bg-neutral-800 overflow-hidden h-80 md:100 lg:h-120"></div>
  <button
    id="check-in-map-fullscreen-btn"
    title="Toggle fullscreen"
    aria-label="Toggle fullscreen"
    style="position:absolute;top:8px;right:8px;z-index:1000;background:white;border:1px solid #ccc;border-radius:4px;padding:4px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#374151;"
  >
    <svg id="check-in-map-expand-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
    </svg>
    <svg id="check-in-map-collapse-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
      <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"/>
    </svg>
  </button>
</div>

<script type="application/json" id="check-in-data" set:html={JSON.stringify(checkIns).replace(/</g, '\\u003c')} />

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import 'leaflet.markercluster';
  import 'leaflet.markercluster/dist/MarkerCluster.css';
  import 'leaflet.markercluster/dist/MarkerCluster.Default.css';
  import markerIcon2x from 'leaflet/dist/images/marker-icon-2x.png';
  import markerIcon from 'leaflet/dist/images/marker-icon.png';
  import markerShadow from 'leaflet/dist/images/marker-shadow.png';

  L.Icon.Default.mergeOptions({
    iconRetinaUrl: markerIcon2x.src ?? markerIcon2x,
    iconUrl: markerIcon.src ?? markerIcon,
    shadowUrl: markerShadow.src ?? markerShadow,
  });

  const dataEl = document.getElementById('check-in-data');
  const checkIns = JSON.parse(dataEl?.textContent ?? '[]');

  function escapeHtml(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function initMap() {
    const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const tileUrl = dark
      ? 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png'
      : 'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png';

    const map = L.map('check-in-map');
    L.tileLayer(tileUrl, {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors ' +
        '&copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 20,
    }).addTo(map);

    const cluster = L.markerClusterGroup();

    for (const c of checkIns) {
      const marker = L.marker([parseFloat(c.latitude), parseFloat(c.longitude)]);
      const date = new Date(c.createdAt).toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      });
      marker.bindPopup(
        '<strong><a href="' + escapeHtml(c.url) + '">' + escapeHtml(c.venueName) + '</a></strong>' +
        (c.venueCategory ? '<br><span style="font-size:0.85em">' + escapeHtml(c.venueCategory) + '</span>' : '') +
        '<br><small>' + date + '</small>'
      );
      cluster.addLayer(marker);
    }

    map.addLayer(cluster);

    if (checkIns.length > 0) {
      map.fitBounds(cluster.getBounds(), { padding: [30, 30] });
    } else {
      map.setView([51.5, -0.1], 10);
    }

    const container = document.getElementById('check-in-map-container');
    const mapEl = document.getElementById('check-in-map');
    const btn = document.getElementById('check-in-map-fullscreen-btn');
    const expandIcon = document.getElementById('check-in-map-expand-icon');
    const collapseIcon = document.getElementById('check-in-map-collapse-icon');
    if (!container || !mapEl || !btn || !expandIcon || !collapseIcon) return;

    let isFullscreen = false;

    const enterFullscreen = () => {
      isFullscreen = true;
      container.style.cssText = 'position:fixed;inset:0;z-index:9999;margin:0;';
      mapEl.style.height = '100dvh';
      mapEl.style.borderRadius = '0';
      expandIcon.style.display = 'none';
      collapseIcon.style.display = '';
      btn.title = 'Exit fullscreen';
      btn.setAttribute('aria-label', 'Exit fullscreen');
      document.body.style.overflow = 'hidden';
      map.invalidateSize();
    };

    const exitFullscreen = () => {
      isFullscreen = false;
      container.style.cssText = '';
      mapEl.style.height = '360px';
      mapEl.style.borderRadius = '';
      expandIcon.style.display = '';
      collapseIcon.style.display = 'none';
      btn.title = 'Toggle fullscreen';
      btn.setAttribute('aria-label', 'Toggle fullscreen');
      document.body.style.overflow = '';
      map.invalidateSize();
    };

    btn.addEventListener('click', function () {
      if (isFullscreen) exitFullscreen(); else enterFullscreen();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isFullscreen) exitFullscreen();
    });
  }

  initMap();
</script>
