---
interface Props {
  /** Rating out of 10 (two points per star). */
  rating: number;
  class?: string;
}
const { rating, class: className } = Astro.props;

const stars = rating / 2;
const full = Math.floor(stars);
const half = stars % 1 >= 0.5;
const slots: ('full' | 'half')[] = [...Array(full).fill('full'), ...(half ? ['half'] : [])];
const path =
  'M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z';
---
<span class:list={['inline-flex items-center gap-px', className]} aria-hidden="true">
  {slots.map((slot) => (
    <svg class="size-4 -translate-y-px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg">
      <path stroke-linecap="round" stroke-linejoin="round" fill={slot === 'full' ? 'currentColor' : 'none'} d={path} />
      {slot === 'half' && (
        <path stroke="none" fill="currentColor" style="clip-path: inset(0 50% 0 0)" d={path} />
      )}
    </svg>
  ))}
</span>
