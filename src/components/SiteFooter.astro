---
import Divider from '@/components/Divider.astro';

// Footer links for homepage only.
// Note: /follow, /contact routes don't exist yet — flagged for Barry to create.
// Colophon lives at /articles/colophon until a top-level route is created.
const links = [
  { href: '/about', label: 'About' },
  { href: '/articles/colophon', label: 'Colophon' },
  { href: '/blogroll', label: 'Blogroll' },
  { href: '/follow', label: 'Follow' },
  { href: '/contact', label: 'Contact' },
  { href: '/search', label: 'Search' },
];
---
<Divider />
<div class="mb-4 text-sm flex gap-4 flex-wrap">
  {links.map(link => (
    <a href={link.href} class="underline">{link.label}</a>
  ))}
</div>
