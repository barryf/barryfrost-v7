---
import Divider from '@/components/Divider.astro';

const links = [
  { href: '/about', label: 'About' },
  { href: '/colophon', label: 'Colophon' },
  { href: '/blogroll', label: 'Blogroll' },
  { href: '/follow', label: 'Follow' },
];
---
<Divider />
<div class="mb-4 text-sm flex gap-4 flex-wrap items-center">
  {links.map(link => (
    <a href={link.href} class="underline">{link.label}</a>
  ))}
  <form action="/search" method="get">
    <input
      type="search"
      name="q"
      placeholder="Search…"
      autocomplete="off"
      class="w-30 sm:w-40 text-sm rounded border border-gray-400 dark:border-gray-600 bg-white dark:bg-black text-gray-900 dark:text-gray-100 placeholder-gray-600 dark:placeholder-gray-400 px-2 py-0.5 focus:outline-none focus:ring-1 focus:ring-gray-400 dark:focus:ring-gray-600"
    />
  </form>
</div>
<p class="text-xs">
  Words and original images &copy; by
  <a href="https://barryfrost.com/" class="underline">Barry Frost</a>
  and licensed under
  <a href="https://creativecommons.org/licenses/by-sa/4.0/" class="underline">CC BY-SA 4.0</a>.
  <a href="https://github.com/barryf/barryfrost-v7" class="underline">Source code</a>.
</p>
