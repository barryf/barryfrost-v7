---
import { STAR_PATH } from '@/lib/icons';

interface Props {
  class?: string;
}
const { class: className = 'size-3 inline-block -translate-y-px' } = Astro.props;
---
<svg class={className} viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <path stroke-linecap="round" stroke-linejoin="round" d={STAR_PATH} />
</svg>
