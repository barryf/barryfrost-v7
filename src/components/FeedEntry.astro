---
import type { FeedItem } from '@/lib/feed';
import ArticleCard from './posts/ArticleCard.astro';
import WeeknoteCard from './posts/WeeknoteCard.astro';
import BlueskyCard from './posts/BlueskyCard.astro';
import CheckinCard from './posts/CheckinCard.astro';
import FilmCard from './posts/FilmCard.astro';
import BookCard from './posts/BookCard.astro';
import PhotoCard from './posts/PhotoCard.astro';
import TypeIcon from './TypeIcon.astro';

interface Props {
  item: FeedItem;
  showIcon?: boolean;
}

const { item, showIcon = true } = Astro.props;

const components = {
  article: ArticleCard,
  weeknote: WeeknoteCard,
  bluesky: BlueskyCard,
  checkin: CheckinCard,
  film: FilmCard,
  book: BookCard,
  photo: PhotoCard,
};

const Component = components[item.type];

const isReply = item.type === 'bluesky' && !!(item.data as { reply?: unknown }).reply;
---
<div class={`py-4 border-b border-neutral-100 dark:border-neutral-800 last:border-0 flex items-start${showIcon ? ' gap-3' : ''}`}>
  {showIcon && (isReply ? (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5 shrink-0 mt-0.5 text-neutral-400 dark:text-neutral-500" aria-label="Reply">
      <path d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
    </svg>
  ) : (
    <TypeIcon type={item.type} class="size-5 shrink-0 mt-0.5 text-neutral-400 dark:text-neutral-500" />
  ))}
  <div class="flex-1 min-w-0">
    <Component item={item} />
  </div>
</div>
