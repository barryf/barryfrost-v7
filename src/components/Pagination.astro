---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath?: string;
}

const { currentPage, totalPages, basePath = '' } = Astro.props;

function pageUrl(page: number): string {
  if (page === 1) return basePath || '/';
  return basePath ? `${basePath}/page/${page}` : `/page/${page}`;
}

const windowSize = 5;
let start = Math.max(1, currentPage - Math.floor(windowSize / 2));
let end = Math.min(totalPages, start + windowSize - 1);
if (end - start < windowSize - 1) start = Math.max(1, end - windowSize + 1);
const pages = Array.from({ length: end - start + 1 }, (_, i) => start + i);
---
{totalPages > 1 && (
  <nav class="flex items-center justify-center gap-4 py-8 text-sm" aria-label="Pagination">
    {currentPage > 1 && (
      <a href={pageUrl(currentPage - 1)} class="underline">← Prev</a>
    )}
    {pages.map(page => (
      page === currentPage ? (
        <span class="font-semibold">{page}</span>
      ) : (
        <a href={pageUrl(page)} class="underline">{page}</a>
      )
    ))}
    {currentPage < totalPages && (
      <a href={pageUrl(currentPage + 1)} class="underline">Next →</a>
    )}
  </nav>
)}
