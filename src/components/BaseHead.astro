---
import { Font } from 'astro:assets';
import { cleanPathname } from '@/lib/url';
import { documentUri, PUBLICATIONS } from '@/lib/standard-site';

interface Props {
  title: string;
  description?: string;
  /** rkey of this page's site.standard.document record — emits the verification link. */
  standardRkey?: string;
  /** Publication key whose site.standard.publication record this page belongs to (discovery). */
  standardPublication?: keyof typeof PUBLICATIONS;
  /** When present, emits og:type=article and article:published_time; otherwise og:type=website. */
  publishedDate?: Date;
  /** First image in the post body, if it has one. There is no default social image. */
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const {
  title,
  description = 'Personal website of Barry Frost',
  standardRkey,
  standardPublication,
  publishedDate,
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
} = Astro.props;
const canonicalURL = new URL(cleanPathname(Astro.url.pathname), Astro.site);
const publicationUri = standardPublication ? PUBLICATIONS[standardPublication].uri : '';
const ogImageURL = ogImage ? new URL(ogImage, Astro.site) : undefined;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="canonical" href={canonicalURL} />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:site_name" content="Barry Frost's Website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
{publishedDate ? (
  <Fragment>
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={publishedDate.toISOString()} />
  </Fragment>
) : (
  <meta property="og:type" content="website" />
)}
{ogImageURL && (
  <Fragment>
    <meta property="og:image" content={ogImageURL} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>
)}
<link rel="preconnect" href="https://images.barryfrost.com" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="alternate" type="application/rss+xml" title="Barry Frost (RSS)" href="/feed.xml" />
<link rel="alternate" type="application/feed+json" title="Barry Frost (JSON Feed)" href="/feed.json" />
<link rel="alternate" type="application/rss+xml" title="Barry Frost — Everything (RSS)" href="/everything.xml" />
<link rel="alternate" type="application/feed+json" title="Barry Frost — Everything (JSON Feed)" href="/everything.json" />
<link rel="me" href="https://github.com/barryf" />
<link rel="me" href="https://mastodon.social/@barryf" />
<link rel="me atproto" href="https://bsky.app/profile/barryfrost.com" />
<link rel="webmention" href="https://webmention.io/barryfrost.com/webmention">
<link rel="microsub" href="https://aperture.p3k.io/microsub/28">
<link rel="authorization_endpoint" href="https://indieauth.com/auth">
<link rel="token_endpoint" href="https://tokens.indieauth.com/token">
{standardRkey && <link rel="site.standard.document" href={documentUri(standardRkey)} />}
{publicationUri && <link rel="site.standard.publication" href={publicationUri} />}
{!import.meta.env.DEV && (
  <script defer src="https://cloud.umami.is/script.js" data-website-id="bcbce94f-c8e0-48fb-aead-d900a8db3a69"></script>
)}
<Font cssVariable="--font-work-sans" preload />
