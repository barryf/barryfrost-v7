---
import { cleanPathname } from '@/lib/url';
import { sectionGroupFor, sectionNavItems, isActiveSection } from '@/lib/nav';

const path = cleanPathname(Astro.url.pathname);
const group = sectionGroupFor(path);
const items = group ? sectionNavItems(group) : [];
---
{items.length > 0 && (
  <nav class="mb-4">
    <ul class="flex flex-wrap gap-x-3 gap-y-1 text-sm">
      {items.map(item => (
        <li>
          {isActiveSection(path, item.href) ? (
            <span class="font-semibold text-nowrap">{item.label}</span>
          ) : (
            <a href={item.href} class="underline text-nowrap">{item.label}</a>
          )}
        </li>
      ))}
    </ul>
  </nav>
)}
