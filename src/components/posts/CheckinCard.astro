---
import { formatDateShort, toISODate } from '@/lib/dates';

interface Props {
  entry: {
    id: string;
    data: {
      venueName: string;
      venueCategory?: string;
      venueAddress?: string;
      latitude?: string;
      longitude?: string;
      rating?: number;
      sourceUrl?: string;
      photoUrls?: string[];
      photoFullUrls?: string[];
      createdAt: string;
    }
  }
}

const { entry } = Astro.props;
const { data } = entry;
const photos = data.photoUrls ?? [];
const fullUrls = data.photoFullUrls ?? [];
const single = photos.length === 1;
const mapUrl = data.latitude && data.longitude
  ? `https://www.openstreetmap.org/?mlat=${data.latitude}&mlon=${data.longitude}&zoom=17`
  : '';
const date = new Date(data.createdAt);
---
<article class="h-entry text-sm leading-relaxed p-3 rounded-xl border bg-gray-50 dark:bg-gray-900 border-gray-300 dark:border-gray-700">
  {photos.length > 1 && (
    <div class="grid grid-cols-2 gap-1 mb-2">
      {photos.map((url, i) => (
        <a href={fullUrls[i] ?? url} rel="noopener noreferrer">
          <img src={url} width="96" height="96" alt="" loading="lazy" decoding="async" class="u-photo w-full aspect-square object-cover rounded" />
        </a>
      ))}
    </div>
  )}
  <div class:list={["p-checkin h-card", single && "flex gap-3 items-start"]}>
    {single && (
      <a href={fullUrls[0] ?? photos[0]} rel="noopener noreferrer">
        <img src={photos[0]} width="72" height="72" alt={data.venueName} loading="lazy" decoding="async" class="u-photo w-18 aspect-square object-cover rounded" />
      </a>
    )}
    <div>
      {mapUrl ? (
        <a href={mapUrl} class="p-name underline" rel="noopener noreferrer">{data.venueName}</a>
      ) : (
        <span class="p-name">{data.venueName}</span>
      )}
      {data.venueCategory && <span class="text-xs text-gray-500 dark:text-gray-500"> · {data.venueCategory}</span>}
      {data.venueAddress && <p class="p-street-address text-xs text-gray-600 dark:text-gray-400">{data.venueAddress}</p>}
      {data.latitude && <data class="p-latitude" value={data.latitude} />}
      {data.longitude && <data class="p-longitude" value={data.longitude} />}
      {data.rating !== undefined && <data class="p-rating hidden" value={data.rating} />}
      <div class="mt-1">
        <time class="dt-published text-xs text-gray-500 dark:text-gray-500" datetime={toISODate(date)}>{formatDateShort(date)}</time>
        {data.sourceUrl && <a href={data.sourceUrl} class="text-xs ml-2 underline" rel="noopener noreferrer">Beaconbits</a>}
      </div>
    </div>
  </div>
</article>
