---
import { formatDateRelative, formatDateTitle, toISODate } from '@/lib/dates';
import AuthorCard from '@/components/AuthorCard.astro';
import StarIcon from '@/components/icons/StarIcon.astro';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      date: Date;
      description?: string;
      featured?: boolean;
    }
  }
}

const { entry } = Astro.props;
const { data } = entry;
const url = `/articles/${entry.id}`;
---
<li class="h-entry mb-4">
  <a class="p-name u-url block underline" href={url}>{data.featured && (<><StarIcon class="mr-1 size-3 inline-block -translate-y-px" /><span class="sr-only">Featured: </span></>)}{data.title}</a>
  <time class="dt-published text-sm text-gray-500 dark:text-gray-400" datetime={toISODate(data.date)} title={formatDateTitle(data.date)}>{formatDateRelative(data.date)}</time>
  <AuthorCard />
</li>
