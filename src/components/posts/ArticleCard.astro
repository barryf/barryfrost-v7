---
import { formatDateShort, toISODate } from '@/lib/dates';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      date: Date;
      description?: string;
    }
  }
}

const { entry } = Astro.props;
const { data } = entry;
const url = `/articles/${entry.id}`;
---
<li class="mb-4">
  <a class="p-name u-url underline" href={url}>{data.title}</a>
  <time class="dt-published text-sm text-gray-500 dark:text-gray-500 ml-2" datetime={toISODate(data.date)}>{formatDateShort(data.date)}</time>
</li>
