---
import { formatDate, toISODate } from '../../lib/dates';
import type { FeedItem } from '../../lib/feed';

interface Props {
  item: FeedItem;
}

const { item } = Astro.props;
const data = item.data as { title: string; creativeWorkType: string; rating?: number; mainCredit?: string; posterUrl?: string };

function toStars(rating: number): string {
  const stars = rating / 2;
  const full = Math.floor(stars);
  const half = stars % 1 >= 0.5;
  return '★'.repeat(full) + (half ? '½' : '');
}
---
<article class="h-entry flex gap-4">
  {data.posterUrl && (
    <div class="p-item h-cite shrink-0">
      <img
        src={data.posterUrl}
        alt={`Poster for ${data.title}`}
        width="48"
        height="72"
        class="u-photo w-12 object-cover rounded"
        loading="lazy"
        decoding="async"
      />
      <a class="p-name u-url hidden" href={item.url} rel="noopener noreferrer">{data.title}</a>
    </div>
  )}
  <div>
    <h2 class="font-semibold">
      <a class="u-url" href={item.url} rel="noopener noreferrer">{data.title}</a>
    </h2>
    <p class="text-sm mt-1 text-neutral-600 dark:text-neutral-400">
      {data.rating !== undefined && <data class="p-rating" value={data.rating} title={`${data.rating}/10`}>{toStars(data.rating)}</data>}
    </p>
    <div class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
      <time class="dt-published" datetime={toISODate(item.date)}>{formatDate(item.date)}</time>
    </div>
  </div>
</article>
