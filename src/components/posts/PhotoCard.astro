---
import { formatDate, toISODate } from '../../lib/dates';
import type { FeedItem } from '../../lib/feed';

interface Props {
  item: FeedItem;
}

const { item } = Astro.props;
const data = item.data as { title: string; address?: string; thumbnailUrls: string[]; photoCount: number };
const thumbs = data.thumbnailUrls ?? [];
---
<article class="h-entry">
  {thumbs.length > 0 && (
    <div class="flex gap-2 mb-2">
      {thumbs.slice(0, 3).map((url) => (
        <img
          src={new URL(url, Astro.url).href}
          alt={data.title}
          width="80"
          height="80"
          class="u-photo flex-1 min-w-0 max-w-30 aspect-square object-cover rounded"
          loading="lazy"
          decoding="async"
        />
      ))}
    </div>
  )}
  <h2 class="font-semibold">
    <a class="p-name u-url" href={item.url} rel="noopener noreferrer">{data.title}</a>
  </h2>
  {data.address && <p class="p-location text-sm text-neutral-600 dark:text-neutral-400">{data.address}</p>}
  <div class="mt-1 flex items-center gap-3 text-sm text-neutral-500 dark:text-neutral-400">
    <time class="dt-published" datetime={toISODate(item.date)}>{formatDate(item.date)}</time>
    {data.photoCount > 1 && <span>{data.photoCount} photos</span>}
    <a href={item.url} class="px-2 py-0.5 text-xs bg-neutral-100 dark:bg-neutral-800 rounded hover:text-neutral-700 dark:hover:text-neutral-300" rel="noopener noreferrer">Grain</a>
  </div>
</article>
