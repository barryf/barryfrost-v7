---
import { formatDateShort, toISODate } from '../../lib/dates';
import type { FeedItem } from '../../lib/feed';

interface Props {
  item: FeedItem;
}

const { item } = Astro.props;
const data = item.data as { title: string; description?: string; address?: string; thumbnailUrls: string[]; photoCount: number };
const thumbs = data.thumbnailUrls ?? [];
const single = thumbs.length === 1;
---
<article class="h-entry">
  <div class:list={[single && "min-[320px]:flex min-[320px]:gap-3 min-[320px]:items-start"]}>
    {single ? (
      <img
        src={new URL(thumbs[0], Astro.url).href}
        alt={data.title}
        width="120"
        height="120"
        class="u-photo w-30 shrink-0 aspect-square object-cover rounded mb-2 min-[320px]:mb-0"
        loading="lazy"
        decoding="async"
      />
    ) : thumbs.length > 0 && (
      <div class="flex gap-2 mb-2">
        {thumbs.slice(0, 4).map((url) => (
          <img
            src={new URL(url, Astro.url).href}
            alt={data.title}
            width="80"
            height="80"
            class="u-photo flex-1 min-w-0 max-w-30 aspect-square object-cover rounded"
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    )}
    <div>
      <h2 class="font-semibold leading-tight mb-1">
        <a class="p-name u-url" href={item.url} rel="noopener noreferrer">{data.title}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="inline size-3.5 ml-1 align-middle" aria-hidden="true"><path d="M6.22 8.72a.75.75 0 0 0 1.06 1.06l5.22-5.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0 0 1.5h1.69L6.22 8.72Z" /><path d="M3.5 6.75c0-.69.56-1.25 1.25-1.25H7A.75.75 0 0 0 7 4H4.75A2.75 2.75 0 0 0 2 6.75v4.5A2.75 2.75 0 0 0 4.75 14h4.5A2.75 2.75 0 0 0 12 11.25V9a.75.75 0 0 0-1.5 0v2.25c0 .69-.56 1.25-1.25 1.25h-4.5c-.69 0-1.25-.56-1.25-1.25v-4.5Z" /></svg></a>
      </h2>
      {data.description && <p class="p-summary text-sm text-neutral-700 dark:text-neutral-300">{data.description}</p>}
      {data.address && <p class="p-location text-sm text-neutral-600 dark:text-neutral-400">{data.address}</p>}
      <div class="mt-1 flex items-center gap-3 text-xs text-neutral-500 dark:text-neutral-400">
        <time class="dt-published" datetime={toISODate(item.date)}>{formatDateShort(item.date)}</time>
        <a href={item.url} class="px-2 py-0.5 bg-neutral-100 dark:bg-neutral-800 rounded hover:text-neutral-700 dark:hover:text-neutral-300" rel="noopener noreferrer">Grain</a>
      </div>
    </div>
  </div>
</article>
