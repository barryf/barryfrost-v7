---
import { formatDateShort, toISODate } from '@/lib/dates';
import { DID } from '@/lib/pds';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      address?: string;
      thumbnailUrls: string[];
      photoCount: number;
      createdAt: string;
      galleryRkey: string;
    }
  }
}

const { entry } = Astro.props;
const { data } = entry;
const thumbs = data.thumbnailUrls ?? [];
const grainUrl = `https://grain.social/profile/${DID}/gallery/${data.galleryRkey}`;
const date = new Date(data.createdAt);
---
<article class="h-entry">
  {thumbs.length > 0 && (
    <div class="overflow-x-auto mb-2">
      <div class="flex gap-1">
        {thumbs.map((url, i) => (
          <a href={grainUrl} rel="noopener noreferrer" class="flex-none">
            <img
              src={url}
              alt={data.title}
              width="120"
              height="120"
              class:list={["u-photo w-30 h-30 aspect-square object-cover",
                i === 0 && "rounded-l-xl",
                i === thumbs.length - 1 && "rounded-r-xl"
              ]}
              loading="lazy"
              decoding="async"
            />
          </a>
        ))}
      </div>
    </div>
  )}
  <div class="text-sm">
    <a class="p-name u-url font-semibold underline" href={grainUrl} rel="noopener noreferrer">{data.title}</a>
    {data.address && <span class="text-xs text-gray-500 dark:text-gray-500 ml-2">{data.address}</span>}
    <div class="mt-1">
      <time class="dt-published text-xs text-gray-500 dark:text-gray-500" datetime={toISODate(date)}>{formatDateShort(date)}</time>
      <a href={grainUrl} class="text-xs ml-2 underline" rel="noopener noreferrer">Grain</a>
    </div>
  </div>
</article>
