---
import { formatRelativeDate, formatDate, toISODate } from '@/lib/dates';
import { DID } from '@/lib/pds';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      address?: string;
      thumbnailUrls: string[];
      photoCount: number;
      createdAt: string;
      galleryRkey: string;
    }
  }
}

const { entry } = Astro.props;
const { data } = entry;
const thumbs = data.thumbnailUrls ?? [];
const grainUrl = `https://grain.social/profile/${DID}/gallery/${data.galleryRkey}`;
const date = new Date(data.createdAt);
---
<article class="h-entry">
  {thumbs.length > 0 && (
    <div class="overflow-x-auto mb-2">
      <div class="flex gap-1">
        {thumbs.map((url, i) => (
          <a href={grainUrl} rel="noopener noreferrer" class="flex-none">
            <img
              src={url}
              alt={data.title}
              width="120"
              height="120"
              class:list={["u-photo w-30 h-30 aspect-square object-cover",
                i === 0 && "rounded-l-xl",
                i === thumbs.length - 1 && "rounded-r-xl"
              ]}
              loading="lazy"
              decoding="async"
            />
          </a>
        ))}
      </div>
    </div>
  )}
  <div>
    <a class="p-name u-url underline" href={grainUrl} rel="noopener noreferrer">{data.title}</a>
    <div class="mt-0">
      <time class="dt-published text-sm" datetime={toISODate(date)} title={formatDate(date)}>{formatRelativeDate(date)}</time>
    </div>
  </div>
</article>
