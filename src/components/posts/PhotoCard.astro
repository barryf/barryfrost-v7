---
import { formatRelativeDate, formatDateTitle, toISODate } from '@/lib/dates';
import { DID, pdslsUrl } from '@/lib/pds';
import { blobImage } from '@/lib/image-url';
import PdslsIcon from '@/components/icons/PdslsIcon.astro';
import GrainIcon from '@/components/icons/GrainIcon.astro';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      description?: string;
      address?: string;
      thumbnailUrls: string[];
      photoCount: number;
      createdAt: string;
      galleryRkey: string;
    }
  }
}

const { entry } = Astro.props;
const { data } = entry;
const thumbs = data.thumbnailUrls ?? [];
const fullUrls = thumbs.map(url => {
  const cid = new URL(url).searchParams.get('cid') ?? '';
  return blobImage(cid, { width: 1000, height: 1000, fit: 'contain' });
});
const grainUrl = `https://grain.social/profile/${DID}/gallery/${data.galleryRkey}`;
const date = new Date(data.createdAt);
---
<article class="h-entry" data-pagefind-body>
  {thumbs.length > 0 && (
    <div class="overflow-x-auto mb-2">
      <div class="flex gap-1">
        {thumbs.map((url, i) => (
          <a href={fullUrls[i]} rel="noopener noreferrer" class="flex-none">
            <img
              src={url}
              alt={data.title}
              width="120"
              height="120"
              class:list={["u-photo w-30 h-30 aspect-square object-cover",
                i === 0 && "rounded-l-xl",
                i === thumbs.length - 1 && "rounded-r-xl"
              ]}
              loading="lazy"
              decoding="async"
            />
          </a>
        ))}
      </div>
    </div>
  )}
  <div>
    <a class="p-name u-url underline inline-flex items-center gap-1" href={grainUrl} rel="noopener noreferrer">
      <GrainIcon />
      {data.title}
    </a>
    {data.description && <p class="text-sm text-gray-600 dark:text-gray-400 mt-0.5">{data.description}</p>}
    <div class="mt-0">
      <time class="dt-published text-sm mr-1" datetime={toISODate(date)} title={formatDateTitle(date)}>{formatRelativeDate(date)}</time>
      <a class="underline" href={pdslsUrl(`at://${DID}/social.grain.gallery/${data.galleryRkey}`)} rel="noopener noreferrer" aria-label="View on PDSls"><PdslsIcon /></a>
    </div>
  </div>
</article>
