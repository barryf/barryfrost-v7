---
import { formatDateShort, toISODate } from '@/lib/dates';
import { renderRichText } from '@/lib/richtext';
import { HANDLE } from '@/lib/pds';
import BlueskyQuote from '@/components/posts/BlueskyQuote.astro';

interface Props {
  entry: {
    id: string;
    data: {
      text: string;
      facets: unknown[];
      reply: { parentHandle: string; parentRkey: string } | null;
      imageUrls: string[];
      imageAlts: string[];
      quotedPost: { available: boolean; uri: string; [key: string]: unknown } | null;
      createdAt: string;
    }
  }
}

const { entry } = Astro.props;
const { data } = entry;
const html = renderRichText(data.text, data.facets as any);
const images = data.imageUrls ?? [];
const alts = data.imageAlts ?? [];
const blueskyUrl = `https://bsky.app/profile/${HANDLE}/post/${entry.id}`;
const date = new Date(data.createdAt);
---
<article class="h-entry text-sm leading-relaxed p-3 rounded-xl border bg-gray-50 dark:bg-gray-900 border-gray-300 dark:border-gray-700">
  {data.reply && (
    <p class="text-xs text-gray-500 dark:text-gray-500 mb-1">
      In reply to <a class="u-in-reply-to underline" href={`https://bsky.app/profile/${data.reply.parentHandle}/post/${data.reply.parentRkey}`} rel="noopener noreferrer">@{data.reply.parentHandle}</a>
    </p>
  )}
  <div class="e-content break-words mb-1" set:html={html} />
  {data.quotedPost && <BlueskyQuote quotedPost={data.quotedPost as any} />}
  {images.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-2 mb-1">
      {images.map((url, i) => (
        <img
          src={url}
          alt={alts[i] ?? ''}
          class="u-photo h-24 w-auto max-w-full rounded"
          loading="lazy"
          decoding="async"
        />
      ))}
    </div>
  )}
  <time class="dt-published text-xs text-gray-500 dark:text-gray-500" datetime={toISODate(date)}>{formatDateShort(date)}</time>
  <a class="u-url text-xs ml-2 underline" href={blueskyUrl} rel="noopener noreferrer">View on Bluesky</a>
</article>
