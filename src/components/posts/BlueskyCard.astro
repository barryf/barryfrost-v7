---
import type { CollectionEntry } from 'astro:content';
import { formatDateRelative, formatDateTitle, toISODate } from '@/lib/dates';
import { renderRichText } from '@/lib/richtext';
import { HANDLE, pdslsUrl } from '@/lib/pds';
import BlueskyQuote from '@/components/posts/BlueskyQuote.astro';
import BlueskyIcon from '@/components/icons/BlueskyIcon.astro';
import PdslsIcon from '@/components/icons/PdslsIcon.astro';
import AuthorCard from '@/components/AuthorCard.astro';

interface Props {
  entry: CollectionEntry<'blueskyPosts'>;
  /** Emit data-pagefind-body so this post is added to the search index. Set false to reuse the card outside the canonical /posts list (e.g. the homepage) without duplicate indexing. */
  indexable?: boolean;
}

const { entry, indexable = true } = Astro.props;
const { data } = entry;
const html = renderRichText(data.text, data.facets as any);
const images = data.imageUrls ?? [];
const largeImages = data.imageLargeUrls ?? [];
const alts = data.imageAlts ?? [];
const external = data.external;
const blueskyUrl = `https://bsky.app/profile/${HANDLE}/post/${entry.id}`;
const date = new Date(data.createdAt);
---
<article class="h-entry" data-pagefind-body={indexable ? '' : undefined}>
  <AuthorCard />
  {data.reply && (
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">
      In reply to <a class="u-in-reply-to underline" href={`https://bsky.app/profile/${data.reply.parentHandle}/post/${data.reply.parentRkey}`} rel="noopener noreferrer">@{data.reply.parentHandle}</a>
    </p>
  )}
  <p class="e-content mb-1 wrap-break-word" set:html={html} />
  {data.quotedPost && <BlueskyQuote quotedPost={data.quotedPost as any} />}
  {images.length > 0 && (
    <div class="overflow-x-auto mt-2 mb-1">
      <div class="flex gap-1">
        {images.map((url, i) => (
          <a href={largeImages[i] ?? url} class="flex-none" aria-label={alts[i] || 'Post image'}>
            <img
              src={url}
              alt={alts[i] ?? ''}
              width="120"
              height="120"
              class:list={["u-photo size-30 aspect-square object-cover",
                i === 0 && "rounded-l-xl",
                i === images.length - 1 && "rounded-r-xl"
              ]}
              loading="lazy"
              decoding="async"
            />
          </a>
        ))}
      </div>
    </div>
  )}
  {external && (external.thumbUrl ? (
    <div class="flex mt-2 mb-1">
      <a href={external.uri} rel="noopener noreferrer" class="block" title={external.title || undefined}>
        <img
          src={external.thumbUrl}
          alt={external.description || external.title || ''}
          class="u-photo w-auto max-w-full rounded"
          style="height:6rem"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  ) : (
    <div class="mt-2 mb-1 text-sm">
      <a class="underline" href={external.uri} rel="noopener noreferrer">{external.title || external.uri}</a>
      {external.description && <p class="text-gray-500 dark:text-gray-400">{external.description}</p>}
    </div>
  ))}
  <div class="text-sm text-gray-500 dark:text-gray-400">
    <time class="dt-published mr-1" datetime={toISODate(date)} title={formatDateTitle(date)}>{formatDateRelative(date)}</time>
    <a class="u-url underline" href={blueskyUrl} rel="noopener noreferrer" aria-label="View on Bluesky"><BlueskyIcon /></a>
    <a class="ml-1 underline" href={pdslsUrl(data.uri)} rel="noopener noreferrer" aria-label="View on PDSls"><PdslsIcon /></a>
  </div>
</article>
