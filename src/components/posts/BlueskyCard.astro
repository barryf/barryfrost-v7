---
import { formatDateShort, formatDateTitle, toISODate } from '@/lib/dates';
import { renderRichText } from '@/lib/richtext';
import { HANDLE, pdslsUrl } from '@/lib/pds';
import BlueskyQuote from '@/components/posts/BlueskyQuote.astro';
import BlueskyIcon from '@/components/icons/BlueskyIcon.astro';
import PdslsIcon from '@/components/icons/PdslsIcon.astro';
import AuthorCard from '@/components/AuthorCard.astro';

interface Props {
  entry: {
    id: string;
    data: {
      text: string;
      facets: unknown[];
      reply: { parentHandle: string; parentRkey: string } | null;
      imageUrls: string[];
      imageLargeUrls: string[];
      imageAlts: string[];
      quotedPost: { available: boolean; uri: string; [key: string]: unknown } | null;
      createdAt: string;
      uri: string;
    }
  }
}

const { entry } = Astro.props;
const { data } = entry;
const html = renderRichText(data.text, data.facets as any);
const images = data.imageUrls ?? [];
const largeImages = data.imageLargeUrls ?? [];
const alts = data.imageAlts ?? [];
const blueskyUrl = `https://bsky.app/profile/${HANDLE}/post/${entry.id}`;
const date = new Date(data.createdAt);
---
<article class="h-entry" data-pagefind-body>
  <AuthorCard />
  {data.reply && (
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">
      In reply to <a class="u-in-reply-to underline" href={`https://bsky.app/profile/${data.reply.parentHandle}/post/${data.reply.parentRkey}`} rel="noopener noreferrer">@{data.reply.parentHandle}</a>
    </p>
  )}
  <p class="e-content mb-1 wrap-break-word" set:html={html} />
  {data.quotedPost && <BlueskyQuote quotedPost={data.quotedPost as any} />}
  {images.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-2 mb-1">
      {images.map((url, i) => (
        <a href={largeImages[i] ?? url} class="block" aria-label={alts[i] || 'Post image'}>
          <img
            src={url}
            alt={alts[i] ?? ''}
            class="u-photo w-auto max-w-full rounded"
            style="height:6rem"
            loading="lazy"
            decoding="async"
          />
        </a>
      ))}
    </div>
  )}
  <div class="mb-4 text-sm text-gray-500 dark:text-gray-400">
    <time class="dt-published mr-1" datetime={toISODate(date)} title={formatDateTitle(date)}>{formatDateShort(date)}</time>
    <a class="u-url underline" href={blueskyUrl} rel="noopener noreferrer" aria-label="View on Bluesky"><BlueskyIcon /></a>
    <a class="ml-1 underline" href={pdslsUrl(data.uri)} rel="noopener noreferrer" aria-label="View on PDSls"><PdslsIcon /></a>
  </div>
</article>
