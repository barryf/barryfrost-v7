---
import { formatDateShort, toISODate } from '../../lib/dates';
import type { FeedItem } from '../../lib/feed';

interface Props {
  item: FeedItem;
}

const { item } = Astro.props;
const data = item.data as { title: string; creativeWorkType: string; rating?: number; mainCredit?: string; posterUrl?: string };

function toStars(rating: number): string {
  const stars = rating / 2;
  const full = Math.floor(stars);
  const half = stars % 1 >= 0.5;
  return '★'.repeat(full) + (half ? '½' : '');
}
---
<article class="h-entry flex gap-4">
  {data.posterUrl && (
    <div class="p-item h-cite shrink-0">
      <img
        src={new URL(data.posterUrl, Astro.url).href}
        alt={`Poster for ${data.title}`}
        width="48"
        height="72"
        class="u-photo w-12 object-cover rounded"
        loading="lazy"
        decoding="async"
      />
      <a class="p-name u-url hidden" href={item.url} rel="noopener noreferrer">{data.title}</a>
    </div>
  )}
  <div>
    <h2 class="font-semibold leading-tight">
      <a class="u-url" href={item.url} rel="noopener noreferrer">{data.title}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="inline size-3.5 ml-1 align-middle" aria-hidden="true"><path d="M6.22 8.72a.75.75 0 0 0 1.06 1.06l5.22-5.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0 0 1.5h1.69L6.22 8.72Z" /><path d="M3.5 6.75c0-.69.56-1.25 1.25-1.25H7A.75.75 0 0 0 7 4H4.75A2.75 2.75 0 0 0 2 6.75v4.5A2.75 2.75 0 0 0 4.75 14h4.5A2.75 2.75 0 0 0 12 11.25V9a.75.75 0 0 0-1.5 0v2.25c0 .69-.56 1.25-1.25 1.25h-4.5c-.69 0-1.25-.56-1.25-1.25v-4.5Z" /></svg></a>
    </h2>
    <p class="text-sm mt-1 text-neutral-600 dark:text-neutral-400">
      {data.rating !== undefined && <data class="p-rating" value={data.rating} title={`${data.rating}/10`}>{toStars(data.rating)}</data>}
    </p>
    <div class="mt-1 flex items-center gap-3 text-xs text-neutral-500 dark:text-neutral-400">
      <time class="dt-published" datetime={toISODate(item.date)}>{formatDateShort(item.date)}</time>
      <a href={item.url} class="px-2 py-0.5 text-xs bg-neutral-100 dark:bg-neutral-800 rounded hover:text-neutral-700 dark:hover:text-neutral-300" rel="noopener noreferrer">Popfeed</a>
    </div>
  </div>
</article>
