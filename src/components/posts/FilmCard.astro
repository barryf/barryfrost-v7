---
import { formatDateShort, formatDateTitle, toISODate } from '@/lib/dates';
import { DID, pdslsUrl } from '@/lib/pds';
import PdslsIcon from '@/components/icons/PdslsIcon.astro';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      creativeWorkType: string;
      rating?: number;
      posterUrl?: string;
      createdAt: string;
      uri: string;
    }
  }
}

const { entry } = Astro.props;
const { data } = entry;
const filmUrl = `https://popfeed.social/review/at:/${DID}/social.popfeed.feed.review/${entry.id}`;
const date = new Date(data.createdAt);

function toStars(rating: number): string {
  const stars = rating / 2;
  const full = Math.floor(stars);
  const half = stars % 1 >= 0.5;
  return '★'.repeat(full) + (half ? '½' : '');
}
---
<article class="h-entry flex gap-3">
  {data.posterUrl && (
    <div class="p-item h-cite shrink-0">
      <a class="p-name u-url" href={filmUrl} rel="noopener noreferrer"><img
        src={data.posterUrl}
        alt={`Poster for ${data.title}`}
        width="56"
        height="84"
        class="u-photo w-14 object-cover rounded"
        loading="lazy"
        decoding="async"
      /></a>
    </div>
  )}
  <div>
    <h2 class="leading-tight mb-1">
      <a class="u-url underline inline-flex items-start gap-1" href={filmUrl} rel="noopener noreferrer">
        {data.title}
      </a>
    </h2>
    {data.rating !== undefined && (
      <p class="mb-0 text-sm text-gray-500 dark:text-gray-500">
        <data class="p-rating" value={data.rating} title={`${data.rating}/10`}>{toStars(data.rating)}</data>
      </p>
    )}
    <div>
      <time class="dt-published text-sm text-gray-500 dark:text-gray-500 mr-1" datetime={toISODate(date)}>{formatDateShort(date)}</time>
        <a class="underline" href={pdslsUrl(data.uri)} rel="noopener noreferrer" aria-label="View on PDSls"><PdslsIcon /></a>
    </div>
  </div>
</article>
