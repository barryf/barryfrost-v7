---
import { formatDateShort, toISODate } from '@/lib/dates';
import { DID } from '@/lib/pds';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      creativeWorkType: string;
      rating?: number;
      posterUrl?: string;
      createdAt: string;
    }
  }
}

const { entry } = Astro.props;
const { data } = entry;
const filmUrl = `https://popfeed.social/review/at:/${DID}/social.popfeed.feed.review/${entry.id}`;
const date = new Date(data.createdAt);

function toStars(rating: number): string {
  const stars = rating / 2;
  const full = Math.floor(stars);
  const half = stars % 1 >= 0.5;
  return '★'.repeat(full) + (half ? '½' : '');
}
---
<article class="h-entry flex gap-3">
  {data.posterUrl && (
    <div class="p-item h-cite shrink-0">
      <img
        src={data.posterUrl}
        alt={`Poster for ${data.title}`}
        width="40"
        height="60"
        class="u-photo w-10 object-cover rounded"
        loading="lazy"
        decoding="async"
      />
      <a class="p-name u-url hidden" href={filmUrl} rel="noopener noreferrer">{data.title}</a>
    </div>
  )}
  <div class="text-sm">
    <h2 class="font-semibold leading-tight">
      <a class="u-url underline" href={filmUrl} rel="noopener noreferrer">{data.title}</a>
    </h2>
    {data.rating !== undefined && (
      <p class="text-xs text-gray-500 dark:text-gray-500 mt-0.5">
        <data class="p-rating" value={data.rating} title={`${data.rating}/10`}>{toStars(data.rating)}</data>
      </p>
    )}
    <div class="mt-1">
      <time class="dt-published text-xs text-gray-500 dark:text-gray-500" datetime={toISODate(date)}>{formatDateShort(date)}</time>
      <a href={filmUrl} class="text-xs ml-2 underline" rel="noopener noreferrer">Popfeed</a>
    </div>
  </div>
</article>
