---
import { formatDate, toISODate } from '../../lib/dates';
import type { FeedItem } from '../../lib/feed';

interface Props {
  item: FeedItem;
}

const { item } = Astro.props;
const data = item.data as { title: string; authors: string; coverUrl?: string; status?: string };
const dateLabel = data.status === 'buzz.bookhive.defs#reading' ? 'Started' : 'Finished';
---
<article class="h-entry flex gap-4">
  <div class="p-read-of h-cite shrink-0">
    {data.coverUrl && (
      <img
        src={new URL(data.coverUrl, Astro.url).href}
        alt={`Cover for ${data.title}`}
        width="48"
        height="72"
        class="u-photo w-12 object-cover rounded"
        loading="lazy"
        decoding="async"
      />
    )}
    <a class="p-name u-url hidden" href={item.url} rel="noopener noreferrer">{data.title}</a>
    <span class="p-author hidden">{data.authors}</span>
  </div>
  <div>
    <h2 class="font-semibold">
      <a href={item.url} rel="noopener noreferrer">{data.title}</a>
    </h2>
    <p class="text-sm text-neutral-600 dark:text-neutral-400">by {data.authors}</p>
    <div class="mt-1 flex items-center gap-3 text-sm text-neutral-500 dark:text-neutral-400">
      <time class="dt-published" datetime={toISODate(item.date)}>{dateLabel} {formatDate(item.date)}</time>
      <a href={item.url} class="px-2 py-0.5 text-xs bg-neutral-100 dark:bg-neutral-800 rounded hover:text-neutral-700 dark:hover:text-neutral-300" rel="noopener noreferrer">Bookhive</a>
    </div>
  </div>
</article>
