---
import { formatRelativeDate, formatDateTitle, toISODate } from '@/lib/dates';
import { pdslsUrl } from '@/lib/pds';
import PdslsIcon from '@/components/icons/PdslsIcon.astro';
import BookHiveIcon from '@/components/icons/BookHiveIcon.astro';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      authors: string;
      coverUrl?: string;
      status: string;
      hiveId?: string;
      startedAt?: string;
      finishedAt?: string;
      createdAt: string;
      uri: string;
    }
  }
}

const { entry } = Astro.props;
const { data } = entry;
const bookhiveUrl = data.hiveId ? `https://bookhive.buzz/books/${data.hiveId}` : '';
const isReading = data.status === 'buzz.bookhive.defs#reading';
const dateLabel = isReading ? 'Started' : 'Finished';
const dateStr = isReading
  ? (data.startedAt ?? data.createdAt)
  : (data.finishedAt ?? data.createdAt);
const date = new Date(dateStr);
---
<article class="h-entry flex gap-3">
  <div class="p-read-of h-cite shrink-0">
    {data.coverUrl && (
      bookhiveUrl ? (
        <a href={bookhiveUrl} rel="noopener noreferrer" aria-label={`${data.title} on BookHive`}>
          <img
            src={data.coverUrl}
            alt={`Cover for ${data.title}`}
            width="60"
            height="80"
            class="u-photo w-15 object-cover rounded"
            loading="lazy"
            decoding="async"
          />
        </a>
      ) : (
        <img
          src={data.coverUrl}
          alt={`Cover for ${data.title}`}
          width="60"
          height="80"
          class="u-photo w-15 object-cover rounded"
          loading="lazy"
          decoding="async"
        />
      )
    )}
    {bookhiveUrl && <a class="p-name u-url hidden" href={bookhiveUrl} rel="noopener noreferrer">{data.title}</a>}
    <span class="p-author hidden">{data.authors}</span>
  </div>
  <div>
    <h2 class="leading-tight mb-1">
      {bookhiveUrl ? (
        <a href={bookhiveUrl} class="underline" rel="noopener noreferrer">
          {data.title}
        </a>
      ) : (
        <span>{data.title}</span>
      )}
    </h2>
    <p class="text-sm text-gray-600 dark:text-gray-400">by {data.authors}</p>
    <div>
      <time class="dt-published text-sm mr-1" datetime={toISODate(date)} title={formatDateTitle(date)}>{dateLabel} {formatRelativeDate(date)}</time>
        <a class="underline" href={pdslsUrl(data.uri)} rel="noopener noreferrer" aria-label="View on PDSls"><PdslsIcon /></a>
    </div>
  </div>
</article>
