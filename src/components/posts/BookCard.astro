---
import { formatDateRelative, formatDateTitle, toISODate } from '@/lib/dates';
import { pdslsUrl } from '@/lib/pds';
import PdslsIcon from '@/components/icons/PdslsIcon.astro';
import AuthorCard from '@/components/AuthorCard.astro';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      authors: string;
      coverUrl?: string;
      status: string;
      hiveId?: string;
      startedAt?: string;
      finishedAt?: string;
      createdAt: string;
      uri: string;
    }
  }
  /** 'lg' gives a bigger cover, used for the books I'm currently reading. */
  size?: 'sm' | 'lg';
}

const { entry, size = 'sm' } = Astro.props;
const { data } = entry;
const coverClass = size === 'lg' ? 'u-photo w-24 object-cover rounded' : 'u-photo w-15 object-cover rounded';
const coverWidth = size === 'lg' ? '96' : '60';
// Covers are stored 2:3 (see the books loader), so reserve that ratio while loading.
const coverHeight = size === 'lg' ? '144' : '90';
const bookhiveUrl = data.hiveId ? `https://bookhive.buzz/books/${data.hiveId}` : '';
const isReading = data.status === 'buzz.bookhive.defs#reading';
const dateLabel = isReading ? 'Started' : 'Finished';
const dateStr = isReading
  ? (data.startedAt ?? data.createdAt)
  : (data.finishedAt ?? data.createdAt);
const date = new Date(dateStr);
---
<article class="h-entry flex gap-3" data-pagefind-body>
  <AuthorCard />
  {data.coverUrl && (
    <div class="shrink-0">
      {bookhiveUrl ? (
        <a href={bookhiveUrl} rel="noopener noreferrer" aria-label={`${data.title} on BookHive`}>
          <img
            src={data.coverUrl}
            alt={`Cover for ${data.title}`}
            width={coverWidth}
            height={coverHeight}
            class={coverClass}
            loading="lazy"
            decoding="async"
          />
        </a>
      ) : (
        <img
          src={data.coverUrl}
          alt={`Cover for ${data.title}`}
          width={coverWidth}
          height={coverHeight}
          class={coverClass}
          loading="lazy"
          decoding="async"
        />
      )}
    </div>
  )}
  <div>
    <h2 class="leading-tight mb-1">
      {bookhiveUrl ? (
        <a href={bookhiveUrl} class="p-name u-url underline" rel="noopener noreferrer">
          {data.title}<span class="sr-only">{isReading ? ' (reading)' : ' (read)'}</span>
        </a>
      ) : (
        <span class="p-name">{data.title}<span class="sr-only">{isReading ? ' (reading)' : ' (read)'}</span></span>
      )}
    </h2>
    <p class="text-sm text-gray-600 dark:text-gray-400">by {data.authors}</p>
    <div>
      <time class="dt-published text-sm mr-1" datetime={toISODate(date)} title={formatDateTitle(date)}>{dateLabel} {formatDateRelative(date)}</time>
        <a class="underline text-gray-500 dark:text-gray-400" href={pdslsUrl(data.uri)} rel="noopener noreferrer" aria-label="View on PDSls"><PdslsIcon /></a>
    </div>
    <div class="p-read-of h-cite hidden">
      <span class="p-name">{data.title}</span>
      {bookhiveUrl && <a class="u-url" href={bookhiveUrl} rel="noopener noreferrer">{data.title}</a>}
      <span class="p-author">{data.authors}</span>
    </div>
  </div>
</article>
