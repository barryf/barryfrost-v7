---
import { formatDateShort, toISODate } from '@/lib/dates';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      authors: string;
      coverUrl?: string;
      status: string;
      hiveId?: string;
      startedAt?: string;
      finishedAt?: string;
      createdAt: string;
    }
  }
}

const { entry } = Astro.props;
const { data } = entry;
const bookhiveUrl = data.hiveId ? `https://bookhive.buzz/books/${data.hiveId}` : '';
const isReading = data.status === 'buzz.bookhive.defs#reading';
const dateLabel = isReading ? 'Started' : 'Finished';
const dateStr = isReading
  ? (data.startedAt ?? data.createdAt)
  : (data.finishedAt ?? data.createdAt);
const date = new Date(dateStr);
---
<article class="h-entry flex gap-3">
  <div class="p-read-of h-cite shrink-0">
    {data.coverUrl && (
      <img
        src={data.coverUrl}
        alt={`Cover for ${data.title}`}
        width="40"
        height="60"
        class="u-photo w-10 object-cover rounded"
        loading="lazy"
        decoding="async"
      />
    )}
    {bookhiveUrl && <a class="p-name u-url hidden" href={bookhiveUrl} rel="noopener noreferrer">{data.title}</a>}
    <span class="p-author hidden">{data.authors}</span>
  </div>
  <div class="text-sm">
    <h2 class="font-semibold leading-tight">
      {bookhiveUrl ? (
        <a href={bookhiveUrl} class="underline" rel="noopener noreferrer">{data.title}</a>
      ) : (
        <span>{data.title}</span>
      )}
    </h2>
    <p class="text-xs text-gray-600 dark:text-gray-400">by {data.authors}</p>
    <div class="mt-1">
      <time class="dt-published text-xs text-gray-500 dark:text-gray-500" datetime={toISODate(date)}>{dateLabel} {formatDateShort(date)}</time>
      {bookhiveUrl && <a href={bookhiveUrl} class="text-xs ml-2 underline" rel="noopener noreferrer">Bookhive</a>}
    </div>
  </div>
</article>
