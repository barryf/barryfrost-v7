---
import { Image } from 'astro:assets';
import { formatDate, toISODate } from '../../lib/dates';
import type { FeedItem } from '../../lib/feed';

interface Props {
  item: FeedItem;
}

const { item } = Astro.props;
const data = item.data as { title: string; authors: string; coverUrl?: string };
---
<article class="h-entry flex gap-4">
  {data.coverUrl && (
    <Image
      src={data.coverUrl}
      alt={`Cover for ${data.title}`}
      width={48}
      height={72}
      densities={[1, 2]}
      quality={90}
      class="w-12 object-cover rounded"
    />
  )}
  <div>
    <h2 class="font-semibold">
      <a class="p-name u-url" href={item.url} rel="noopener noreferrer">{data.title}</a>
    </h2>
    <p class="text-sm text-neutral-600 dark:text-neutral-400">by {data.authors}</p>
    <div class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
      <time class="dt-published" datetime={toISODate(item.date)}>Finished {formatDate(item.date)}</time>
    </div>
  </div>
</article>
