---
import { formatRelativeDate, formatDateTitle, toISODate } from '@/lib/dates';
import { pdslsUrl } from '@/lib/pds';
import PdslsIcon from '@/components/icons/PdslsIcon.astro';

interface Props {
  entry: {
    id: string;
    data: {
      venueName: string;
      venueCategory?: string;
      venueAddress?: string;
      latitude?: string;
      longitude?: string;
      rating?: number;
      sourceUrl?: string;
      photoUrls?: string[];
      photoFullUrls?: string[];
      createdAt: string;
      uri: string;
    }
  }
}

const { entry } = Astro.props;
const { data } = entry;
const photos = data.photoUrls ?? [];
const fullUrls = data.photoFullUrls ?? [];
const single = photos.length === 1;
const mapUrl = data.latitude && data.longitude
  ? `https://www.openstreetmap.org/?mlat=${data.latitude}&mlon=${data.longitude}&zoom=17`
  : '';
const date = new Date(data.createdAt);
---
<article class="h-entry">
  {photos.length > 1 && (
    <div class="grid grid-cols-2 gap-1 mb-2">
      {photos.map((url, i) => (
        <a href={fullUrls[i] ?? url} rel="noopener noreferrer">
          <img src={url} width="96" height="96" alt="" loading="lazy" decoding="async" class="u-photo w-full aspect-square object-cover rounded" />
        </a>
      ))}
    </div>
  )}
  <div class:list={["p-checkin h-card mb-4", single && "flex gap-3 items-start"]}>
    {single && (
      <a href={fullUrls[0] ?? photos[0]} rel="noopener noreferrer">
        <img src={photos[0]} width="72" height="72" alt={data.venueName} loading="lazy" decoding="async" class="u-photo min-w-24 aspect-square object-cover rounded" />
      </a>
    )}
    <div>
      {mapUrl ? (
        <a href={mapUrl} class="p-name underline" rel="noopener noreferrer">{data.venueName}</a>
      ) : (
        <span class="p-name">{data.venueName}</span>
      )}
      {data.venueCategory && <div class="text-sm text-gray-500 dark:text-gray-500">{data.venueCategory}</div>}
      {data.venueAddress && <p class="p-street-address text-sm text-gray-500 dark:text-gray-500">{data.venueAddress}</p>}
      {data.latitude && <data class="p-latitude" value={data.latitude} />}
      {data.longitude && <data class="p-longitude" value={data.longitude} />}
      {data.rating !== undefined && <data class="p-rating hidden" value={data.rating} />}
      <div class="">
        <time class="dt-published text-sm text-gray-500 dark:text-gray-500" datetime={toISODate(date)} title={formatDateTitle(date)}>{formatRelativeDate(date)}</time>
        <a class="ml-1 underline" href={pdslsUrl(data.uri)} rel="noopener noreferrer" aria-label="View on PDSls"><PdslsIcon /></a>
        {data.sourceUrl && <a href={data.sourceUrl} class="text-sm ml-2 underline" rel="noopener noreferrer">Beaconbits</a>}
      </div>
    </div>
  </div>
</article>
