---
import { formatDateShort, formatDateTitle, toISODate } from '@/lib/dates';
import { pdslsUrl } from '@/lib/pds';
import PdslsIcon from '@/components/icons/PdslsIcon.astro';
import AuthorCard from '@/components/AuthorCard.astro';

interface Props {
  entry: {
    id: string;
    data: {
      venueName: string;
      venueCategory?: string;
      venueStreet?: string;
      venueLocality?: string;
      venueRegion?: string;
      venuePostalCode?: string;
      latitude?: string;
      longitude?: string;
      rating?: number;
      sourceUrl?: string;
      photoUrls?: string[];
      photoFullUrls?: string[];
      createdAt: string;
      uri: string;
    }
  }
}

const { entry } = Astro.props;
const { data } = entry;
const photos = data.photoUrls ?? [];
const fullUrls = data.photoFullUrls ?? [];
const single = photos.length === 1;
const mapUrl = data.latitude && data.longitude
  ? `https://www.openstreetmap.org/?mlat=${data.latitude}&mlon=${data.longitude}&zoom=17`
  : '';
const date = new Date(data.createdAt);
const addrParts = [
  data.venueStreet && { cls: 'p-street-address', val: data.venueStreet },
  data.venueLocality && { cls: 'p-locality', val: data.venueLocality },
  data.venueRegion && { cls: 'p-region', val: data.venueRegion },
  data.venuePostalCode && { cls: 'p-postal-code', val: data.venuePostalCode },
].filter((p): p is { cls: string; val: string } => Boolean(p));
---
<article class="h-entry" data-pagefind-body>
  <AuthorCard />
  {photos.length > 1 && (
    <div class="grid grid-cols-2 gap-1 mb-2">
      {photos.map((url, i) => (
        <a href={fullUrls[i] ?? url} rel="noopener noreferrer" aria-label={`Photo ${i + 1} at ${data.venueName}`}>
          <img src={url} width="96" height="96" alt="" loading="lazy" decoding="async" class="u-photo w-full aspect-square object-cover rounded" />
        </a>
      ))}
    </div>
  )}
  <div class:list={[single && "flex gap-3 items-start"]}>
    {single && (
      <a href={fullUrls[0] ?? photos[0]} rel="noopener noreferrer" class="shrink-0">
        <img src={photos[0]} width="72" height="72" alt={data.venueName} loading="lazy" decoding="async" class="u-photo min-w-24 aspect-square object-cover rounded" />
      </a>
    )}
    <div class="p-checkin h-card">
      {mapUrl ? (
        <a href={mapUrl} class="p-name u-url underline" rel="noopener noreferrer">{data.venueName}</a>
      ) : (
        <span class="p-name">{data.venueName}</span>
      )}
      {data.venueCategory && <div class="text-sm text-gray-500 dark:text-gray-400">{data.venueCategory}</div>}
      {addrParts.length > 0 && (
        <p class="p-adr h-adr text-sm text-gray-500 dark:text-gray-400">
          {addrParts.map((part, i) => (
            <Fragment>{i > 0 && ', '}<span class={part.cls}>{part.val}</span></Fragment>
          ))}
        </p>
      )}
      {data.latitude && <data class="p-latitude" value={data.latitude} />}
      {data.longitude && <data class="p-longitude" value={data.longitude} />}
    </div>
  </div>
  {data.rating !== undefined && <data class="p-rating hidden" value={data.rating} />}
  <div class="mb-4 text-gray-500 dark:text-gray-400">
    <time class="dt-published text-sm" datetime={toISODate(date)} title={formatDateTitle(date)}>{formatDateShort(date)}</time>
    <a class="ml-1 underline" href={pdslsUrl(data.uri)} rel="noopener noreferrer" aria-label="View on PDSls"><PdslsIcon /></a>
    {data.sourceUrl && <a href={data.sourceUrl} class="u-syndication text-sm ml-2 underline" rel="noopener noreferrer">Beaconbits</a>}
  </div>
</article>
