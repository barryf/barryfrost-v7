---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/articles', label: 'Articles' },
  { href: '/weeknotes', label: 'Weeknotes' },
  { href: '/posts', label: 'Posts' },
  { href: '/checkins', label: 'Checkins' },
  { href: '/films', label: 'Films' },
  { href: '/photos', label: 'Photos' },
  { href: '/books', label: 'Books' },
  { href: '/blogroll', label: 'Blogroll' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/now', label: 'Now' },
];
---
<header class="max-w-2xl mx-auto px-4 py-6">
  <nav class="flex flex-wrap items-center gap-x-6 gap-y-2">
    <a href="/" class="text-lg font-bold">Barry Frost</a>
    {navLinks.slice(1).map(link => (
      <a href={link.href} class="text-sm text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100">
        {link.label}
      </a>
    ))}
    <form action="/search" method="get" class="ml-auto">
      <input
        type="search"
        name="q"
        placeholder="Search…"
        autocomplete="off"
        class="text-sm w-36 rounded border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 px-2 py-0.5 focus:outline-none focus:ring-1 focus:ring-neutral-400 dark:focus:ring-neutral-600"
      />
    </form>
  </nav>
</header>
