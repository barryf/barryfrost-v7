# Content-Security-Policy notes — the site is static HTML, so this is a tight policy
# with four deliberate loosenings:
#   script-src 'unsafe-inline'  — /search and /check-ins ship inline scripts, and the
#     check-in data is an inline application/json block. Hashes would have to be
#     regenerated into this static file on every build, so they aren't practical here.
#   script-src 'wasm-unsafe-eval' — Pagefind's search index is WebAssembly.
#   style-src 'unsafe-inline'   — Astro inlines critical CSS in a <style> block on every
#     page, and Leaflet sets inline style attributes on tiles and markers at runtime.
#   img-src https:              — image-store.ts falls back to the direct source URL
#     whenever an image can't be materialised into R2, and that source may be any PDS,
#     AppView or CDN host, so an origin allowlist would break images unpredictably.
#     Blogroll favicons hot-link www.google.com for the same reason.
# Everything else defaults to 'none'.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cloud.umami.is; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self'; connect-src 'self' https://cloud.umami.is https://gateway.umami.is; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=3600
